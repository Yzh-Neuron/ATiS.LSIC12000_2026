<Window x:Class="ZoneSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZoneSimulator"
        Title="LSIC12000 老化区模拟器" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="10,8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="监听端口：" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Width="70" Text="8002" Margin="0,0,8,0" />
                <Button x:Name="StartBtn" Content="启动服务" Click="OnStartServer" FontWeight="Bold" />
                <Button x:Name="StopBtn" Content="停止服务" Click="OnStopServer" IsEnabled="False" />
                <TextBlock x:Name="ServerStatus" Text="未启动" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#888" FontWeight="Bold" />
                <TextBlock Text="（启动后软件连 127.0.0.1:8002 即对应 Config.ini 的 Z0）"
                           VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
            </StackPanel>
        </Border>

        <GroupBox DockPanel.Dock="Bottom" Header="日志" Height="170">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4" />
        </GroupBox>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="已连接老化区">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="无连接时请先在软件里连接老化区"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" />
                    <ListBox x:Name="ZoneList" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#666" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <TabControl Grid.Column="1" Margin="8,0,0,0">
                <TabItem Header="状态与老化">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <GroupBox Header="区状态">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="上报状态：" VerticalAlignment="Center" />
                                        <ComboBox x:Name="StateCombo" Width="150" Margin="0,0,8,0"
                                                  ItemsSource="{x:Static local:EnumLists.ZoneStates}" />
                                        <Button Content="上报状态" Click="OnSendState" />
                                        <CheckBox x:Name="PlugCheck" Content="老化板已插板" VerticalAlignment="Center"
                                                  Margin="16,0,0,0" Checked="OnPlugChanged" Unchecked="OnPlugChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="开始老化" Click="OnStartBurn" FontWeight="Bold" />
                                        <Button Content="停止老化" Click="OnStopBurn" />
                                        <Button Content="复位到空闲" Click="OnReset" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="老化进度">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="总时长(s)" VerticalAlignment="Center" />
                                        <TextBox x:Name="BurnTotalBox" Width="60" Text="600" Margin="4,0,12,0" />
                                        <TextBlock Text="已运行(s)" VerticalAlignment="Center" />
                                        <TextBox x:Name="BurnCostBox" Width="60" Text="0" Margin="4,0,12,0" />
                                        <TextBlock Text="步次" VerticalAlignment="Center" />
                                        <TextBox x:Name="BurnStepBox" Width="40" Text="0" Margin="4,0,12,0" />
                                        <TextBlock Text="向量" VerticalAlignment="Center" />
                                        <TextBox x:Name="BurnVectorBox" Width="40" Text="0" Margin="4,0,12,0" />
                                        <Button Content="上报进度" Click="OnSendBurn" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="AutoCheck" Content="自动推进" IsChecked="True" VerticalAlignment="Center"
                                                  Checked="OnAutoChanged" Unchecked="OnAutoChanged" Margin="0,0,8,0" />
                                        <TextBlock Text="每500ms推进(s)" VerticalAlignment="Center" />
                                        <TextBox x:Name="SpeedBox" Width="40" Text="5" Margin="4,0,0,0" LostFocus="OnSpeedChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="温控">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="目标温度(℃)" VerticalAlignment="Center" />
                                    <TextBox x:Name="ThermoBox" Width="60" Text="85" Margin="4,0,8,0" />
                                    <Button Content="设置并上报" Click="OnThermo" />
                                    <TextBlock x:Name="ThermoActualText" Text="实际: --" VerticalAlignment="Center" Margin="16,0,0,0"
                                               Foreground="#666" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="其他上报">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="电源方案号" VerticalAlignment="Center" />
                                    <TextBox x:Name="PlanBox" Width="40" Text="0" Margin="4,0,8,0" />
                                    <Button Content="上报方案" Click="OnPlan" />
                                    <TextBlock Text="Trigger" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <ComboBox x:Name="TriggerCombo" Width="90" Margin="4,0,8,0"
                                              ItemsSource="{x:Static local:EnumLists.TriggerTypes}" />
                                    <TextBlock Text="Pin" VerticalAlignment="Center" />
                                    <TextBox x:Name="TriggerPinBox" Width="36" Text="0" Margin="4,0,8,0" />
                                    <Button Content="上报Trigger" Click="OnTrigger" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="电源 (DPS)">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="应用修改" Click="OnApplyDps" FontWeight="Bold" />
                            <Button Content="全部上电" Click="OnAllDpsOn" />
                            <Button Content="全部下电" Click="OnAllDpsOff" />
                            <Button Content="上报电源状态" Click="OnSendDpsState" />
                            <TextBlock Text="（直接编辑单元格后点“应用修改”；电压 mV / 电流 mA / 温度 0.1℃）"
                                       VerticalAlignment="Center" Foreground="#888" FontSize="11" />
                        </StackPanel>
                        <DataGrid x:Name="DpsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="通道" Binding="{Binding Name}" IsReadOnly="True" Width="70" />
                                <DataGridTextColumn Header="输入(mV)" Binding="{Binding InputVoltage}" Width="*" />
                                <DataGridTextColumn Header="输出(mV)" Binding="{Binding OutputVoltage}" Width="*" />
                                <DataGridTextColumn Header="电流(mA)" Binding="{Binding OutputCurrent}" Width="*" />
                                <DataGridTextColumn Header="温度(0.1℃)" Binding="{Binding Temperature}" Width="*" />
                                <DataGridTemplateColumn Header="状态" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static local:EnumLists.DpsStates}"
                                                      SelectedItem="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="故障注入">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <CheckBox x:Name="AllZonesCheck" Content="对全部已连接区生效（否则仅作用于选中的区）" Margin="2,0,0,8" />

                            <GroupBox Header="区级错误（触发报警弹窗，状态切到 Error）">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="DPS 故障：通道" VerticalAlignment="Center" />
                                        <TextBox x:Name="ErrDpsIdBox" Width="36" Text="0" Margin="4,0,8,0" />
                                        <TextBlock Text="故障状态" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ErrDpsStateCombo" Width="150" Margin="4,0,8,0"
                                                  ItemsSource="{x:Static local:EnumLists.DpsFaultStates}" />
                                        <Button Content="注入 DPS 故障" Click="OnErrDps" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="向量错误：类型" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ErrPatternCombo" Width="90" Margin="4,0,8,0"
                                                  ItemsSource="{x:Static local:EnumLists.PatternErrorTypes}" />
                                        <TextBlock Text="步次" VerticalAlignment="Center" />
                                        <TextBox x:Name="ErrPatternStepBox" Width="36" Text="0" Margin="4,0,8,0" />
                                        <TextBlock Text="向量" VerticalAlignment="Center" />
                                        <TextBox x:Name="ErrPatternVectorBox" Width="36" Text="0" Margin="4,0,8,0" />
                                        <Button Content="注入向量错误" Click="OnErrPattern" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="设备错误(hex)：" VerticalAlignment="Center" />
                                        <TextBox x:Name="ErrDeviceBox" Width="120" Text="01 02" Margin="4,0,8,0" />
                                        <Button Content="注入设备错误" Click="OnErrDevice" FontWeight="Bold" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="回检报错（错误列表 / 错误库，需处于 Burning 才累计）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="条数" VerticalAlignment="Center" />
                                    <TextBox x:Name="CmpCountBox" Width="44" Text="5" Margin="4,0,12,0" />
                                    <TextBlock Text="步次" VerticalAlignment="Center" />
                                    <TextBox x:Name="CmpStepBox" Width="36" Text="0" Margin="4,0,12,0" />
                                    <TextBlock Text="向量" VerticalAlignment="Center" />
                                    <TextBox x:Name="CmpVectorBox" Width="36" Text="0" Margin="4,0,8,0" />
                                    <Button Content="上报回检报错" Click="OnCompareError" FontWeight="Bold" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="自检 / 升级 / 版本">
                                <WrapPanel>
                                    <Button Content="设备自检·通过" Click="OnCheckPass" />
                                    <Button Content="设备自检·含失败" Click="OnCheckFail" />
                                    <Button Content="DPS自检·通过" Click="OnDpsCheckPass" />
                                    <Button Content="DPS自检·含失败" Click="OnDpsCheckFail" />
                                    <Button Content="模拟固件升级" Click="OnUpgrade" />
                                    <Button Content="上报板卡版本" Click="OnBoards" />
                                    <Button Content="上报老化进程" Click="OnBurnState" />
                                </WrapPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
