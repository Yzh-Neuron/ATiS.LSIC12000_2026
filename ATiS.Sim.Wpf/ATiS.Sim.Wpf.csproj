<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0-windows7.0</TargetFrameworks>
	  <LangVersion>13</LangVersion>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <DebugType>embedded</DebugType>
	  <Nullable>enable</Nullable>
	  <UseWPF>true</UseWPF>
  </PropertyGroup>

	<!--tt文件自动-->
	<PropertyGroup>
		<TransformOnBuild>true</TransformOnBuild>
	</PropertyGroup>
	
	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>WPF 控件库</Description>
		<Authors>严自浩</Authors>
		<Company>杭可仪器</Company>
		<Copyright>Copyright © 2026</Copyright>
		<Version>1.0.0.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
	</PropertyGroup>
	
	<ItemGroup>
	  <None Remove="Resources\Images\ATiS.png" />
	  <None Remove="Resources\Images\Cloud.png" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.158" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\ATiS.png" />
    <Resource Include="Resources\Images\Cloud.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Lang\FrameworkLanguageProvider.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>FrameworkLanguageProvider.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Lang\FrameworkLanguageProvider.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FrameworkLanguageProvider.tt</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
