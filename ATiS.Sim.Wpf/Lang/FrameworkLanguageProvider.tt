<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.IO" #>
<#
    string templateDir = Path.GetDirectoryName(this.Host.TemplateFile);
    string xamlPath = Path.Combine(templateDir, @"..\Themes\Basic\Languages\zh-CN.xaml");
    xamlPath = Path.GetFullPath(xamlPath);
    if (!File.Exists(xamlPath))
    {
        throw new FileNotFoundException($"未找到资源文件: {xamlPath}");
    }

    XDocument xdoc = XDocument.Load(xamlPath);
    XNamespace xNs = "http://schemas.microsoft.com/winfx/2006/xaml";

    var nodes = xdoc.Descendants()
        .Where(e => e.Name.LocalName == "String" && e.Attribute(xNs + "Key") != null)
        .ToList();

    var kvs = new List<(string Key, string Prop, string Comment)>();
    var seen = new HashSet<string>();

    foreach (var e in nodes)
    {
        string rawKey = e.Attribute(xNs + "Key").Value;
        string prop = rawKey
            .Replace(".", "_")
            .Replace("-", "_")
            .Replace("[", "_")
            .Replace("]", ""); 
        string comment = (e.Value ?? "").Trim();

        if (prop.Length > 0 && char.IsDigit(prop[0]))
        {
            prop = "_" + prop;
        }

        if (!seen.Add(prop))
        {
            throw new Exception($"x:Key{rawKey}重复");
        }

        kvs.Add((rawKey, prop, comment));
    }
#>
using System;
using System.Windows.Markup;

namespace ATiS.Sim.Wpf
{
    public sealed partial class FrameworkLanguageProvider : LanguageProviderBase
    {
        public static FrameworkLanguageProvider Instance { get; } = new();
        public UiLanguage CurrentLanguage => GlobalLanguageManager.CurrentLanguage;

<#
    foreach (var kv in kvs)
    {
#>
        /// <summary><#= kv.Comment #></summary>
        public string <#= kv.Prop #> => GetString("<#= kv.Key #>");
<#
    }
#>

        protected internal override void OnLanguageChanged()
        {
            OnPropertyChanged(nameof(CurrentLanguage));
<#
    foreach (var kv in kvs)
    {
#>
            OnPropertyChanged(nameof(<#= kv.Prop #>));
<#
    }
#>
        }
    }

    public static class LgK
    {
<#
    foreach (var kv in kvs)
    {
#>
        /// <summary><#= kv.Comment #></summary>
        public const string <#= kv.Prop #> = nameof(<#= kv.Prop #>);
<#
    }
#>
    }


    [MarkupExtensionReturnType(typeof(object))]
    public class LgExtension : MarkupExtension
    {
        public string PropertyName { get; }

        public LgExtension(string propertyName)
        {
            PropertyName = propertyName;
        }

        public override object ProvideValue(IServiceProvider serviceProvider)
        {
            var binding = new System.Windows.Data.Binding(PropertyName)
            {
                Source = FrameworkLanguageProvider.Instance
            };
            return binding.ProvideValue(serviceProvider);
        }
    }
}