<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ATiS.Sim.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ATiS.Sim.Wpf;component/Themes/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  窗口按钮  -->
    <Style x:Key="Button.TitleBar"
           BasedOn="{StaticResource Button.Icon}"
           TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="29" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="wpf:IconHelper.Width" Value="10" />
        <Setter Property="wpf:IconHelper.Height" Value="10" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MaskBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.TitleBarClose"
           BasedOn="{StaticResource Button.TitleBar}"
           TargetType="Button">
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#e81123" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeWindow.Default"
           BasedOn="{StaticResource Control.Base}"
           TargetType="{x:Type wpf:ChromeWindow}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="ShadowMargin" Value="5" />
        <Setter Property="IsShowTitleBar" Value="True" />
        <Setter Property="TitleBarHeight" Value="{Binding Path=(SystemParameters.WindowNonClientFrameThickness).Top}" />
        <Setter Property="TitleBarBackground" Value="{DynamicResource SecondBackgroundBrush}" />
        <Setter Property="TitleBarForeground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect" Value="{StaticResource EffectShadow1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wpf:ChromeWindow}">
                    <wpf:SimplePanel>
                        <wpf:ClipBorder x:Name="PART_Border"
                                        Margin="{TemplateBinding ShadowMargin}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Effect="{TemplateBinding Effect}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  标题栏  -->
                                <Grid Name="PART_TitleBar"
                                      Height="{TemplateBinding TitleBarHeight}"
                                      Background="{TemplateBinding TitleBarBackground}"
                                      Visibility="Visible"
                                      TextElement.Foreground="{TemplateBinding TitleBarForeground}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Width="16"
                                           Height="16"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Source="{TemplateBinding Icon}" />

                                    <TextBlock Grid.Column="1"
                                               Padding="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding Title}" />

                                    <StackPanel Name="ButtonPanel"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Orientation="Horizontal"
                                                UseLayoutRounding="True"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button Name="ButtonMin"
                                                VerticalAlignment="Center"
                                                wpf:IconHelper.Geometry="{StaticResource Geometry.WindowMin}"
                                                Command="SystemCommands.MinimizeWindowCommand"
                                                Style="{StaticResource Button.TitleBar}" />
                                        <Button Name="ButtonMax"
                                                VerticalAlignment="Center"
                                                wpf:IconHelper.Geometry="{StaticResource Geometry.WindowMax}"
                                                Command="SystemCommands.MaximizeWindowCommand"
                                                Style="{StaticResource Button.TitleBar}" />
                                        <Button Name="ButtonRestore"
                                                VerticalAlignment="Center"
                                                wpf:IconHelper.Geometry="{StaticResource Geometry.WindowRestore}"
                                                Command="SystemCommands.RestoreWindowCommand"
                                                Style="{StaticResource Button.TitleBar}" />
                                        <Button Name="ButtonClose"
                                                VerticalAlignment="Center"
                                                wpf:IconHelper.Geometry="{StaticResource Geometry.WindowClose}"
                                                Command="SystemCommands.CloseWindowCommand"
                                                Style="{StaticResource Button.TitleBarClose}" />
                                    </StackPanel>
                                </Grid>

                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" ClipToBounds="True" />
                                </AdornerDecorator>
                            </Grid>
                        </wpf:ClipBorder>
                    </wpf:SimplePanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_TitleBar" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonRestore" Property="Visibility" Value="Visible" />

                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="ShadowMargin" Value="0" />
                            <Setter Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Normal">
                            <Setter TargetName="ButtonMax" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="ButtonMin" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger  Property="IsShowTitleBar"  Value="False">
                            <Setter TargetName="PART_TitleBar"  Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ChromeWindow.Default}" TargetType="{x:Type wpf:ChromeWindow}" />
</ResourceDictionary>