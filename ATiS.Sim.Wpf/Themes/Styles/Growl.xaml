<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ATiS.Sim.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ATiS.Sim.Wpf;component/Themes/Styles/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="Growl.Default" BasedOn="{StaticResource Control.Base}" TargetType="{x:Type wpf:Growl}">
        <Setter Property="wpf:BorderHelper.CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ThirdBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Padding" Value="{StaticResource DefaultControlPadding}" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wpf:Growl}">
                    <Grid x:Name="PART_MainGrid">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding wpf:BorderHelper.CornerRadius}"
                                Effect="{DynamicResource EffectShadow3}" />

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="PART_Icon"
                                      Width="12"
                                      Height="12"
                                      Data="{TemplateBinding Icon}"
                                      Fill="{TemplateBinding IconBrush}"
                                      Stretch="Uniform" />

                                <TextBlock x:Name="PART_Title"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />

                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Time}"
                                           Visibility="{TemplateBinding ShowDateTime,
                                                                        Converter={StaticResource TrueToVisibilityConverter}}" />

                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="6"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        wpf:IconHelper.Geometry="{StaticResource Geometry.CloseSmall}"
                                        wpf:IconHelper.Height="14"
                                        wpf:IconHelper.Width="14"
                                        Command="{x:Static wpf:ControlCommands.Close}"
                                        Foreground="{DynamicResource SecondForegroundBrush}"
                                        Style="{StaticResource Button.Icon}"
                                        Visibility="Hidden" />
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondForegroundBrush}"
                                       Text="{TemplateBinding Message}"
                                       TextWrapping="Wrap" />

                            <Grid x:Name="PART_MorePanel"
                                  Grid.Row="4"
                                  Height="20"
                                  VerticalAlignment="Center"
                                  IsEnabled="False"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Static wpf:ControlCommands.Confirm}"
                                        Content="{wpf:Lg {x:Static wpf:LgK.ConfirmText}}"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Style="{StaticResource Button.Base}" />

                                <Rectangle Grid.Column="1"
                                           Width="1"
                                           VerticalAlignment="Stretch"
                                           Fill="{TemplateBinding BorderBrush}" />

                                <Button Grid.Column="2"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Static wpf:ControlCommands.Cancel}"
                                        Content="{wpf:Lg {x:Static wpf:LgK.CancelText}}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Style="{StaticResource Button.Base}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Type" Value="Success">
                            <Setter TargetName="PART_Title" Property="Text"  Value="{wpf:Lg {x:Static wpf:LgK.Success}}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Info">
                            <Setter TargetName="PART_Title" Property="Text" Value="{wpf:Lg {x:Static wpf:LgK.Info}}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Warning">
                            <Setter TargetName="PART_Title" Property="Text" Value="{wpf:Lg {x:Static wpf:LgK.Warning}}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Error">
                            <Setter TargetName="PART_Title" Property="Text" Value="{wpf:Lg {x:Static wpf:LgK.Error}}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Fatal">
                            <Setter TargetName="PART_Title" Property="Text" Value="{wpf:Lg {x:Static wpf:LgK.Fatal}}" />
                        </Trigger>
                        <Trigger Property="Type" Value="Question">
                            <Setter TargetName="PART_Title" Property="Text" Value="{wpf:Lg {x:Static wpf:LgK.Question}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Growl.Default}" TargetType="{x:Type wpf:Growl}" />
</ResourceDictionary>