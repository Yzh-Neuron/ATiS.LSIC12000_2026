<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ATiS.Sim.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ATiS.Sim.Wpf;component/Themes/Styles/Bases/Themes.Basic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="AtisLogo.Default" TargetType="{x:Type wpf:AtisLogo}">
        <Setter Property="LogoBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="DotBrush" Value="Red" />
        <Setter Property="RegisteredBrush" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wpf:AtisLogo}">
                    <Viewbox Stretch="Uniform">
                        <Grid>
                            <Path Data="{StaticResource Geometry.ATIS}"
                                  Fill="{TemplateBinding LogoBrush}"
                                  Stretch="Uniform" />
                            <Ellipse Width="20"
                                     Height="20"
                                     Margin="153,-3,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Fill="{TemplateBinding DotBrush}" />
                            <TextBlock Margin="232,-20,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontFamily="Arial"
                                       FontSize="26"
                                       FontWeight="ExtraBold"
                                       Foreground="{TemplateBinding RegisteredBrush}"
                                       Text="®" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style BasedOn="{StaticResource AtisLogo.Default}" TargetType="{x:Type wpf:AtisLogo}" />
</ResourceDictionary>