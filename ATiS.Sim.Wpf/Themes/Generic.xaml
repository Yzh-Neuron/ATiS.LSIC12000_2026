									</Track.IncreaseRepeatButton>
									<Track.Thumb>
										<Thumb Style="{StaticResource Thumb.HorizontalScrollBar}" />
									</Track.Thumb>
								</Track>
							</wpf:SimplePanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
