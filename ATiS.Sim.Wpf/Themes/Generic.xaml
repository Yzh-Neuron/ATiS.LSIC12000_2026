								<Button x:Name="PART_CloseButton" Grid.Column="6" MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center" wpf:IconHelper.Geometry="{StaticResource Geometry.CloseSmall}" wpf:IconHelper.Height="14" wpf:IconHelper.Width="14" Command="{x:Static wpf:ControlCommands.Close}" Foreground="{DynamicResource SecondForegroundBrush}" Style="{StaticResource Button.Icon}" Visibility="Hidden" />
