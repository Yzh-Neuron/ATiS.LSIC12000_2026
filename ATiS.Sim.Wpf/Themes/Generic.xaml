								<Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch" Fill="{TemplateBinding BorderBrush}" />
								<Button Grid.Column="2" Margin="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{x:Static wpf:ControlCommands.Cancel}" Content="{wpf:Lg {x:Static wpf:LgK.CancelText}}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource Button.Base}" />
