<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:Double x:Key="TextFontSize">12</sys:Double>
    
    <sys:Double x:Key="DefaultControlHeight">26</sys:Double>
    <Thickness x:Key="DefaultControlPadding">10,2</Thickness>
    <Thickness x:Key="DefaultInputPadding">10,0</Thickness>
    <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>


    <sys:Double x:Key="DefaultScrollBarThumbSize">8</sys:Double>
    <sys:Double x:Key="DefaultScrollBarThumbRadius">0</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">30</sys:Double>

    <CornerRadius x:Key="DefaultCheckBoxCornerRadius">0</CornerRadius>

    <sys:Double x:Key="DefaultCalendarDayButtonRadius">5</sys:Double>

    <sys:Double x:Key="DefaultItemHeight">31</sys:Double>
</ResourceDictionary>
