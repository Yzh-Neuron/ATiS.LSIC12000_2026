<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Info">Information</sys:String>
    <sys:String x:Key="Warning">Warning</sys:String>
    <sys:String x:Key="Error">Error</sys:String>
    <sys:String x:Key="Fatal">Fatal</sys:String>
    <sys:String x:Key="Success">Success</sys:String>
    <sys:String x:Key="Question">Question</sys:String>

    <sys:String x:Key="ConfirmText">Confirm</sys:String>
    <sys:String x:Key="CancelText">Cancel</sys:String>
    <sys:String x:Key="YesText">Yes</sys:String>
    <sys:String x:Key="NoText">No</sys:String>

    <sys:String x:Key="NullDataSet">NullDataSet</sys:String>
    <sys:String x:Key="ClearText">Clear</sys:String>
</ResourceDictionary>