<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="PrimaryColor">#64B2FD</Color>
    <Color x:Key="ForegroundColor">White</Color>
    <Color x:Key="SecondForegroundColor">#969696</Color>
    <Color x:Key="ThirdlyForegroundColor">#6e6e6e</Color>
    <Color x:Key="FourthForegroundColor">#c0c6cf</Color>
    <Color x:Key="ContrastForegroundColor">#222228</Color>
    
    <Color x:Key="BorderColor">#4A4A54</Color>
    <Color x:Key="SecondBorderColor">White</Color>
    <Color x:Key="WindowBorderColor">#5A5A63</Color>
    
    <Color x:Key="BackgroundColor">#2B2B31</Color>
    <Color x:Key="SecondBackgroundColor">#222228</Color>
    <Color x:Key="ThirdBackgroundColor">#2B2B31</Color>

    <Color x:Key="ErrorColor">#FF5C5C</Color>
    <Color x:Key="FatalColor">#FF5252</Color>
    <Color x:Key="WarningColor">#FFCF46</Color>
    <Color x:Key="InfoColor">#00D0FF</Color>
    <Color x:Key="SuccessColor">#3BE342</Color>
    <Color x:Key="QuestionColor">#B56AFF</Color>
    <Color x:Key="IgnoreColor">#45454A</Color>
    
    <Color x:Key="HighlighColor">#3f3f46</Color>
    <Color x:Key="MaskColor">#40000000</Color>
</ResourceDictionary>