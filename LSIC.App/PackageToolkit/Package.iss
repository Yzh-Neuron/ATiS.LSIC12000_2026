; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppPublisher "浙江杭可仪器有限公司"
#define MyAppURL "http://hkyq.com.cn/"
#define MyAppExeName "LSIC.App.exe"
#define MyAppVersion GetVersionNumbersString("..\LSIC.App.exe")
#define MyEnviroment "windowsdesktop-runtime-8.0.25-win-x64.exe"
#define MyDotNetVersion "8.0"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{2E16D0D3-C884-4988-B1DF-285EDFA01ABC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName= {code:GetDefaultDir}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
PrivilegesRequired=admin
OutputDir=.\{#MyAppName} Publish {#MyAppVersion}\
OutputBaseFilename={#MyProject}_Setup_{#MyAppVersion}_Release
SetupIconFile=..\..\..\LSIC.App\Resources\Icon\icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
UsePreviousAppDir=yes

[Code]
function IsDriveExists(DriveLetter: Char): Boolean;
var
  Drive: String;
begin
  Drive := DriveLetter + ':\';
  Result := DirExists(Drive);
end;

function GetDefaultDir(Default: String): String;
begin
  if IsDriveExists('D') then
  begin
    Result := 'D:\{#MyAppName}';
  end
  else
  begin
    Result := 'C:\{#MyAppName}';
  end;
end;

// 基于注册表检测 .NET Desktop Runtime 8 是否已安装
function IsDotNetDesktopRuntimeInstalled(DotNetVersion: string): Boolean;
var
  Key32: string;
  Names: TArrayOfString;
  I: Integer;
  DWordValue: Cardinal;
begin
  // 32 位注册表视图（WOW6432Node）
  Key32 := 'SOFTWARE\WOW6432Node\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App';
  if RegGetValueNames(HKLM, Key32, Names) then
  begin
    for I := 0 to GetArrayLength(Names) - 1 do
    begin
      if Pos(DotNetVersion, Names[I]) = 1 then
      begin
        if RegQueryDWordValue(HKLM, Key32, Names[I], DWordValue) and (DWordValue = 1) then
        begin
          Result := True;
          Exit;
        end;
      end;
    end;
  end;
end;

var
  DepPage: TWizardPage;
  DepHint: TNewStaticText;

procedure InitializeWizard;
begin
  // 在“欢迎”页之后插入“必备组件”页
  DepPage := CreateCustomPage(wpWelcome, '安装必备组件', '.NET Desktop Runtime 8');
  DepHint := TNewStaticText.Create(DepPage);
  with DepHint do
  begin
    Parent := DepPage.Surface;
    Caption := '未检测到 .NET Desktop Runtime 8，点击 “下一步” 将开始安装。';
    Left := ScaleX(0);
    Top := ScaleY(0);
    Width := DepPage.SurfaceWidth;
    WordWrap := True;
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if (DepPage <> nil) and (CurPageID = DepPage.ID) then
  begin
    if IsDotNetDesktopRuntimeInstalled('{#MyDotNetVersion}') then
      DepHint.Caption := '已检测到 .NET Desktop Runtime 8，无需安装。'
    else
      DepHint.Caption := '未检测到 .NET Desktop Runtime 8，点击 “下一步” 将开始安装。';
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  ResultCode: Integer;
  Started: Boolean;
begin
  Result := True;
  if (DepPage <> nil) and (CurPageID = DepPage.ID) then
  begin
    if not IsDotNetDesktopRuntimeInstalled('{#MyDotNetVersion}') then
    begin
      ExtractTemporaryFile('{#MyEnviroment}');
      Started := Exec(ExpandConstant('{tmp}\{#MyEnviroment}'), '/passive /norestart', '', SW_SHOWNORMAL, ewWaitUntilTerminated, ResultCode);
      if not Started then
      begin
        MsgBox('无法启动 .NET Desktop Runtime 安装程序。', mbError, MB_OK);
        Result := False;
        Exit;
      end;

      // 安装结束后复检
      if not IsDotNetDesktopRuntimeInstalled('{#MyDotNetVersion}') then
      begin
        MsgBox('未能成功安装 .NET Desktop Runtime 8.0', mbError, MB_OK);
        Result := False;
        Exit;
      end
      else
      begin
        DepHint.Caption := '已成功安装 .NET Desktop Runtime 8。';
      end;
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
    // 卸载主文件后，清理程序运行时生成的文件（这些不在安装包 [Files] 列表里，Inno Setup 默认不删）
    if CurUninstallStep = usPostUninstall then
    begin
        // ATiS.Dongle 运行时从嵌入资源提取的 native 互操作 dll
        DelTree(ExpandConstant('{app}\x64'), True, True, True);
        DelTree(ExpandConstant('{app}\x86'), True, True, True);
        // 运行时创建的 SQLite 数据库
        DeleteFile(ExpandConstant('{app}\System.db'));
    end;
end;
[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
; Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; 整体拷贝编译输出目录所有文件（递归子目录），排除需要加密的自家 dll、排除混淆输出目录与打包工具自身
Source: "..\*"; DestDir: "{app}"; Excludes: "\ATIS.Pattern.dll;\ATiS.Base.dll;\ATiS.Dongle.dll;\ATiS.Sim.Communication.dll;\ATiS.Sim.Log.dll;\ATiS.Sim.Mvvm.dll;\ATiS.Sim.Wpf.dll;\LSIC.App.dll;\Confused\*;\PackageToolkit\*"; Flags: ignoreversion recursesubdirs createallsubdirs

; 从 Confused 目录拷贝加密（混淆）后的自家 dll，覆盖到安装根目录
Source: "..\Confused\LSIC.App.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATIS.Pattern.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Base.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Dongle.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Sim.Communication.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Sim.Log.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Sim.Mvvm.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Confused\ATiS.Sim.Wpf.dll"; DestDir: "{app}"; Flags: ignoreversion

; .NET Desktop Runtime 安装包（仅解压到临时目录供安装时运行，不拷入目标目录）
Source: "{#MyEnviroment}"; DestDir: "{app}"; Flags: dontcopy ignoreversion
[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent runascurrentuser