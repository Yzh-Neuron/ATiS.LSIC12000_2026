<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf">

    <Style BasedOn="{StaticResource {x:Type oxy:Plot}}" TargetType="{x:Type oxy:Plot}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="IsLegendVisible" Value="True" />
        <Setter Property="LegendTextColor" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="PlotAreaBorderColor" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="PlotAreaBorderThickness" Value="1,0,0,1" />
    </Style>

    <Style TargetType="{x:Type oxy:LinearAxis}">
        <Setter Property="Position" Value="Left" />
        <Setter Property="MajorGridlineColor" Value="{DynamicResource ChartGridlineMajorColor}" />
        <Setter Property="MajorGridlineStyle" Value="Solid" />
        <Setter Property="MajorGridlineThickness" Value="1" />
        <Setter Property="MinorGridlineColor" Value="{DynamicResource ChartGridlineMinorColor}" />
        <Setter Property="MinorGridlineStyle" Value="Solid" />
        <Setter Property="MinorGridlineThickness" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="TicklineColor" Value="{DynamicResource ForegroundColor}" />
    </Style>

    <Style TargetType="{x:Type oxy:DateTimeAxis}">
        <Setter Property="Position" Value="Bottom" />
        <Setter Property="IntervalType" Value="Auto" />
        <Setter Property="MajorGridlineColor" Value="{DynamicResource ChartGridlineMajorColor}" />
        <Setter Property="MajorGridlineStyle" Value="Solid" />
        <Setter Property="MajorGridlineThickness" Value="1" />
        <Setter Property="MinorGridlineColor" Value="{DynamicResource ChartGridlineMinorColor}" />
        <Setter Property="MinorGridlineStyle" Value="Solid" />
        <Setter Property="MinorGridlineThickness" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="TicklineColor" Value="{DynamicResource ForegroundColor}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type oxy:TrackerControl}}" TargetType="{x:Type oxy:TrackerControl}">
        <Setter Property="Background" Value="{DynamicResource ThirdBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>