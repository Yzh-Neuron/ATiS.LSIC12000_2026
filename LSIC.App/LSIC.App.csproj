<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<LangVersion>13</LangVersion>
		<UseWPF>true</UseWPF>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<ApplicationManifest>Properties\app.manifest</ApplicationManifest>
		<ApplicationIcon>Resources\Icon\icon.ico</ApplicationIcon>
		<RestorePackagesPath>..\ZipPackages</RestorePackagesPath>
		<NoWarn>1701;1702;CA1416;NU1701</NoWarn>
		<DebugType>embedded</DebugType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<!--tt文件自动-->
	<PropertyGroup>
		<TransformOnBuild>true</TransformOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
		<OutputPath>..\bin\$(Configuration)</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<OutputPath>..\bin\$(Configuration)</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Icon\icon.ico" />
		<None Remove="Resources\Image\DeviceTopView.png" />
		<None Remove="Resources\Image\HighVoltage.png" />
		<None Remove="Resources\Image\Technology.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ATiS.Sim.Communication\ATiS.Sim.Communication.csproj" />
		<ProjectReference Include="..\ATiS.Sim.Log\ATiS.Sim.Log.csproj" />
		<ProjectReference Include="..\ATiS.Sim.Mvvm\ATiS.Sim.Mvvm.csproj" />
		<ProjectReference Include="..\ATiS.Sim.Wpf\ATiS.Sim.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Icon\icon.ico" />
		<Resource Include="Resources\Image\DeviceTopView.png" />
		<Resource Include="Resources\Image\HighVoltage.png" />
		<Resource Include="Resources\Image\Technology.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Config.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Scripts\Dps\*.dps">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Lang\LangProvider.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>LangProvider.cs</LastGenOutput>
		</None>
	</ItemGroup>

	<ItemGroup>
