<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ZoneStateChangedLog">老化区状态: {0}</sys:String>
    <sys:String x:Key="BurnInBoardInsertedChangedLog">插板状态：{0}</sys:String>
    <sys:String x:Key="ZoneDpsErrorLog">电源错误:{0} -> [{1}]</sys:String>
    <sys:String x:Key="ZoneVIHErrorLog">电源错误: VIH{0} -> [{1}]</sys:String>
    <sys:String x:Key="ZonePatternErrorLog">向量错误: [{0}] 请检查第{1}步 第{2}组向量配置</sys:String>
    <sys:String x:Key="ZoneDeviceErrorLog">设备异常: 请联系售后人员! 错误码[{0}]</sys:String>
    <sys:String x:Key="IcErrorTextLog">器件配置错误, 请检查后重试! {0}</sys:String>
    <sys:String x:Key="FileNotFoundLog">文件未找到: {0}, 请检查!</sys:String>
    <sys:String x:Key="FileParseErrorLog">文件解析失败: {0} 位于{1}行{2}列</sys:String>
    <sys:String x:Key="PatternCheckErrorLog">向量文件校验错误: {0}</sys:String>
    <sys:String x:Key="SendParameterLog">老化器件: [{0}]</sys:String>
    <sys:String x:Key="StepRunInfoLog">当前步次: [{0}]&#x0009;向量: [{1}]</sys:String>
    <sys:String x:Key="RunDpsCheckScriptLog">运行电源自检脚本: {0}</sys:String>
    
    <sys:String x:Key="DpsCheckResultLog" xml:space="preserve">电源自检[{0}/{1}] ->{2}    {3}V    {4}A    ({5}/{6})</sys:String>

    <sys:String x:Key="StopBurnOnSmokyLog">检测到烟雾，老化已停止</sys:String>
    <sys:String x:Key="StopBurnOnOvenErrorLog">检测到烘箱异常，老化已停止</sys:String>
    <sys:String x:Key="StopBurnOnEmergencyLog">检测到急停按钮被按下，老化已停止</sys:String>

    <sys:String x:Key="NoFileMatchedLog">没有找到任何匹配的文件</sys:String>
    <sys:String x:Key="BatchExportSuccessLog">已导出: {0}</sys:String>
    <sys:String x:Key="BatchExportFailureLog">导出失败: {0}，请检查文件是否被占用</sys:String>
    <sys:String x:Key="BatchExportFinishedLog">批量导出完成，共导出{0}个文件, 耗时{1:F2}秒</sys:String>

    <sys:String x:Key="SpiDataTooLargeLog">SPI数据过大: {0}，请检查</sys:String>
</ResourceDictionary>