    <sys:String x:Key="SendIcDataMessage">Send IC data [ {0} ]</sys:String>
    <sys:String x:Key="UnsupportedDataFileMessage">Unsupported data file</sys:String>

    <sys:String x:Key="UpgradeSelectZoneMessage">Please select at least one zone to upgrade</sys:String>
