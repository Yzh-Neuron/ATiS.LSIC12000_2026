    <sys:String x:Key="ImportIcNameExistsMessage" xml:space="preserve">Name repeat, Rename it?</sys:String>
    <sys:String x:Key="NameNotNullMessage">Name cannot be empty or contain spaces</sys:String>
    <sys:String x:Key="NameNotExceedMessage">Name cannot exceed {0} characters</sys:String>
    <sys:String x:Key="NameExistMessage">Name already exists</sys:String>
