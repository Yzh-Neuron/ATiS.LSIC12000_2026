    <sys:String x:Key="ZoneDpsErrorMessage">
        DPS error: {0} ->[{1}]
    </sys:String>
    <sys:String x:Key="ZoneVIHErrorMessage">
        DPS error: VIH{0} ->[{1}]
    </sys:String>
