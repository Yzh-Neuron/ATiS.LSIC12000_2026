    <sys:String x:Key="ForceExitOnTimeoutMessage">Release timed out, force exiting</sys:String>

    <!-- Separator -->
    <sys:String x:Key="SplitCharUnsupportedMessage">Unsupported separator</sys:String>
    <sys:String x:Key="SplitCharInvalidMessage">Invalid separator</sys:String>

    <!-- Burn-in board -->
    <sys:String x:Key="BurnInBoardNotParsedMessage">Burn-in board configuration not parsed, cannot enter burn-in interface</sys:String>

    <!-- Process loop -->
    <sys:String x:Key="LoopStepMissingMessage">The loop references a step that does not exist in the process.</sys:String>
    <sys:String x:Key="LoopRangeInvalidMessage">Invalid loop range: the start step must precede the end step and stay within bounds.</sys:String>
    <sys:String x:Key="LoopContainsPowerMessage">Loops cannot contain fixed power-up or power-down blocks.</sys:String>
    <sys:String x:Key="LoopSelectConsecutiveMessage">Please select consecutive vector steps (power-up/power-down steps excluded).</sys:String>
    <sys:String x:Key="LoopOverlapMessage">Loops can only be placed side by side; nesting or crossing is not allowed.</sys:String>
    <sys:String x:Key="LoopStartNotFoundMessage">Loop start step &quot;{0}&quot; does not exist.</sys:String>
    <sys:String x:Key="LoopEndNotFoundMessage">Loop end step &quot;{0}&quot; does not exist.</sys:String>

    <!-- Zone and process -->
    <sys:String x:Key="ZoneNotInBurnMessage">Burn-in not started, cannot send configuration</sys:String>
    <sys:String x:Key="ProcessStepTypeUnknownMessage">Unrecognized process step type.</sys:String>
    <sys:String x:Key="SetStepsAsLoopMessage">Set selected steps as a loop</sys:String>
</ResourceDictionary>
