    <sys:String x:Key="InvalidPasswordMessage">Invalid password</sys:String>
    <sys:String x:Key="UnhandledExceptionMessage">Unhandled Exception, {0}</sys:String>

    <sys:String x:Key="InitMessage">Init...</sys:String>
