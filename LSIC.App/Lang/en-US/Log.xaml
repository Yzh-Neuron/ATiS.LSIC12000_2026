<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ZoneStateChangedLog">Zone state: {0}</sys:String>
    <sys:String x:Key="BurnInBoardInsertedChangedLog">BIB state：{1}</sys:String>
    <sys:String x:Key="ZoneDpsErrorLog">DPS error: {0} -> [{1}]</sys:String>
    <sys:String x:Key="ZoneVIHErrorLog">DPS error: VIH{0} -> [{1}]</sys:String>
    <sys:String x:Key="ZonePatternErrorLog">Pattern error: [{0}] please check step {1} vector step {2}</sys:String>
    <sys:String x:Key="ZoneDeviceErrorLog">Device error: please contact FAE! Error code [{0}]</sys:String>
    <sys:String x:Key="IcErrorTextLog">Ic error, please check and retry! {0}</sys:String>
    <sys:String x:Key="FileNotFoundLog">File not found: {0}!</sys:String>
    <sys:String x:Key="FileParseErrorLog">File parse error: {0} Line {1} Column {2}</sys:String>
    <sys:String x:Key="PatternCheckErrorLog">Pattern file check error: {0}</sys:String>
    <sys:String x:Key="SendParameterLog">Test ic: [{0}]</sys:String>
    <sys:String x:Key="StepRunInfoLog">Step: [{0}]&#x0009;Vector step: [{1}]</sys:String>
    <sys:String x:Key="RunDpsCheckScriptLog">Run DPS diagnosis script: {0}</sys:String>

    <sys:String x:Key="DpsCheckResultLog" xml:space="preserve">DPS Diagnosis [{0}/{1}] ->{2}    {3}V    {4}A    ({5}/{6})</sys:String>

    <sys:String x:Key="StopBurnOnSmokyLog">Detect smoke，burn stopped!</sys:String>
    <sys:String x:Key="StopBurnOnOvenErrorLog">Oven error，burn stopped</sys:String>
    <sys:String x:Key="StopBurnOnEmergencyLog">EMO button pressed，burn stopped</sys:String>

    <sys:String x:Key="NoFileMatchedLog">No file matched!</sys:String>
    <sys:String x:Key="BatchExportSuccessLog">Export: {0}</sys:String>
    <sys:String x:Key="BatchExportFailureLog">Failure: {0}</sys:String>
    <sys:String x:Key="BatchExportFinishedLog">Batch export finidhed，file count {0}, cost {1:F2} seconds</sys:String>

    <sys:String x:Key="SpiDataTooLargeLog">SPI data too large: {0}, please check!</sys:String>
</ResourceDictionary>