<wpf:ChromeWindow x:Class="LSIC.App.Views.PopPatternConverterView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:pattern="clr-namespace:ATIS.Pattern;assembly=ATIS.Pattern"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.PatternFormatConvertText}}"
                  Width="600"
                  Height="480"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <wpf:ChromeWindow.Resources>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <wpf:SimplePanel>
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    SnapsToDevicePixels="True" />

                            <ContentPresenter Grid.Row="1" 
                                              Margin="10"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <TextBlock Grid.Row="0"
                                       Margin="10,-8,0,0"
                                       Padding="5,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Background="{DynamicResource SecondBackgroundBrush}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="{TemplateBinding Header}" />
                        </wpf:SimplePanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathTextBoxStyle.Default"
               BasedOn="{StaticResource {x:Type TextBox}}"
               TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
        </Style>

        <Style x:Key="LogTextBoxStyle.Default"
               BasedOn="{StaticResource {x:Type TextBox}}"
               TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextBlock.LineHeight" Value="22" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
        </Style>

        <Style x:Key="ChoseButtonStyle.Default"
               BasedOn="{StaticResource {x:Type Button}}"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="FormatButtonStyle.Default"
               BasedOn="{StaticResource {x:Type Button}}"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="ProgressOverlayStyle.Default" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource ThirdBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </wpf:ChromeWindow.Resources>
    <pattern:PatternWorkspace Margin="10,15,10,10" />
</wpf:ChromeWindow>
