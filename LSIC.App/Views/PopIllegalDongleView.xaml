<wpf:ChromeWindow x:Class="LSIC.App.Views.PopIllegalDongleView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.LicenseCertificationText}}"
                  Height="Auto"
                  MinWidth="470"
                  d:DataContext="{d:DesignInstance views:PopIllegalDongleView}"
                  AllowsTransparency="True"
                  CornerRadius="10"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterScreen"
                  WindowStyle="None"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Text="{app:Lang {x:Static app:LangKey.MachineCodeText}}" />
        <TextBlock Grid.Column="1"
                   Margin="0,0,10,0"
                   Text=":" />
        <TextBox Grid.Column="2"
                 FontSize="13"
                 IsReadOnly="True"
                 Text="{Binding Machine}"
                 TextAlignment="Center" />
        <Button Grid.Column="3"
                Margin="5,0,0,0"
                Click="OnCopyButtonClick"
                Content="{app:Lang {x:Static app:LangKey.CopyText}}" />

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondForegroundBrush}"
                   Text="{Binding Prompt}" />
    </Grid>
</wpf:ChromeWindow>
