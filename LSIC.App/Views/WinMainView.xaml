<wpf:ChromeWindow x:Class="LSIC.App.Views.WinMainView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="WinMainView"
                  Width="1280"
                  Height="900"
                  MinWidth="1280"
                  MinHeight="900"
                  d:DataContext="{d:DesignInstance vms:WinMainViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  WindowStartupLocation="CenterScreen"
                  mc:Ignorable="d">
    <DockPanel>
        <!--  顶部工具栏  -->
        <Border Height="80"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,1"
                DockPanel.Dock="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image Grid.RowSpan="2"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{StaticResource Image.ATiS}"
                       UseLayoutRounding="True" />
                <Grid Grid.Row="0" Grid.Column="1">
                    <Menu x:Name="ToolsMenu"
                          Margin="5,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <MenuItem Padding="10,0"
                                  Header="{app:Lang {x:Static app:LangKey.HelpMenuText}}"
                                  InputGestureText="Alt + H">
                            <MenuItem Click="OnAboutButtonClick" Header="{app:Lang {x:Static app:LangKey.AboutText}}" />
                        </MenuItem>
                    </Menu>
                </Grid>
                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Background="{DynamicResource BackgroundBrush}">
                    <StackPanel Height="80"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                        <Button Width="32"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                wpf:IconHelper.Geometry="{StaticResource Geometry.Ic}"
                                wpf:IconHelper.Height="13"
                                wpf:IconHelper.Width="13"
                                Command="{Binding OpenIcEditViewCommand}"
                                ToolTip="{app:Lang {x:Static app:LangKey.IcEditText}}" />

                        <Button Width="32"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                wpf:IconHelper.Geometry="{StaticResource Geometry.PatternConvert}"
                                wpf:IconHelper.Height="13"
                                wpf:IconHelper.Width="13"
                                Command="{Binding PatternConvertCommand}"
                                ToolTip="{app:Lang {x:Static app:LangKey.PatternFormatConvertText}}" />

                        <Button Width="32"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                wpf:IconHelper.Geometry="{StaticResource Geometry.TriggerSet}"
                                wpf:IconHelper.Height="13"
                                wpf:IconHelper.Width="13"
                                Command="{Binding SetTriggerChanneCommand}"
                                ToolTip="{app:Lang {x:Static app:LangKey.TriggerSetText}}" />

                        <Button Width="32"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                wpf:IconHelper.Geometry="{StaticResource Geometry.Thermometer}"
                                wpf:IconHelper.Height="13"
                                wpf:IconHelper.Width="13"
                                Command="{Binding OvenControlCommand}"
                                ToolTip="{app:Lang {x:Static app:LangKey.OvenControlText}}" />

                        <Button Width="32"
                                Height="32"
                                Margin="5,0"
                                Padding="0"
                                wpf:IconHelper.Geometry="{StaticResource Geometry.Mute}"
                                wpf:IconHelper.Height="13"
                                wpf:IconHelper.Width="13"
                                Command="{Binding CloseAlarmCommand}"
                                ToolTip="{app:Lang {x:Static app:LangKey.CloseAlarmText}}" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Column="2"
                           Height="1"
                           VerticalAlignment="Bottom"
                           DockPanel.Dock="Top"
                           Fill="{StaticResource BorderBrush}" />

                <Rectangle Grid.RowSpan="2"
                           Grid.Column="1"
                           Width="1"
                           HorizontalAlignment="Left"
                           DockPanel.Dock="Top"
                           Fill="{StaticResource BorderBrush}" />
            </Grid>
        </Border>

        <!--  底部状态栏  -->
        <Border Height="30"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Bottom">
            <TextBlock Margin="0,0,10,0"
                       HorizontalAlignment="Right"
                       Text="{Binding Now, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
        </Border>

        <!--  老化界面  -->
        <views:CtrHomeView />
        <!--<TabControl wpf:BorderHelper.CornerRadius="0"
                    wpf:TabControlHelper.HeaderHeight="50"
                    wpf:TabControlHelper.HeaderWidth="40"
                    BorderThickness="0,0,0,1"
                    TabStripPlacement="Left">
            <TabItem>
                <TabItem.Header>
                    <Image Width="20" Source="{StaticResource Image.Blocks}" />
                </TabItem.Header>
                <views:CtrHomeView />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <Image Width="20" Source="{StaticResource Image.DataView}" />
                </TabItem.Header>
            </TabItem>
        </TabControl>-->
    </DockPanel>
</wpf:ChromeWindow>
