<wpf:ChromeWindow x:Class="LSIC.App.Views.PopRunStrategyView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.DpsEditText}}"
                  MinWidth="350"
                  d:DataContext="{d:DesignInstance vms:PopRunStrategyViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
            <TextBlock Width="55" Text="{app:Lang {x:Static app:LangKey.LoopModeText}}" />
            <TextBlock Margin="3,0,10,0" Text=":" />
            <ComboBox Width="75"
                      DisplayMemberPath="Value"
                      ItemsSource="{Binding Source={x:Type app:RunMode}, Converter={StaticResource EnumToTextPairsConverter}, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValue="{Binding RunStrategy.Mode}"
                      SelectedValuePath="Key" />
        </StackPanel>

        <wpf:SimplePanel Grid.Row="2" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" Visibility="{Binding RunStrategy.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Time'}">
                <TextBlock Width="55" Text="{app:Lang {x:Static app:LangKey.LoopTimeText}}" />
                <TextBlock Margin="3,0,10,0" Text=":" />
                <TextBox Grid.Column="2"
                         Width="100"
                         Text="{Binding RunStrategy.Time.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}" />

                <ComboBox Grid.Column="3"
                          Width="75"
                          Margin="5,0,0,0"
                          wpf:LanguageHelper.Auto="True"
                          DisplayMemberPath="Value"
                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                          SelectedValue="{Binding RunStrategy.Time.Unit, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Key" />

            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding RunStrategy.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Times'}">
                <TextBlock Width="55" Text="{app:Lang {x:Static app:LangKey.LoopTimesText}}" />
                <TextBlock Margin="3,0,10,0" Text=":" />
                <TextBox Grid.Column="2"
                         Width="100"
                         Text="{Binding RunStrategy.Count, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}" />
                <TextBlock Margin="5,0,0,0" Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
            </StackPanel>
        </wpf:SimplePanel>

        <Button Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource Button.Confirm}" />


        <Button Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Cancel}" />
    </Grid>
</wpf:ChromeWindow>
