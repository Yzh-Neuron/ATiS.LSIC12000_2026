<wpf:ChromeWindow x:Class="LSIC.App.Views.PopAbmViewerView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:pattern="clr-namespace:ATIS.Pattern;assembly=ATIS.Pattern"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.AbmFileViewerText}}"
                  Width="700"
                  Height="600"
                  d:DataContext="{d:DesignInstance vms:PopAbmViewerViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegments}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox x:Name="ABMTextBox"
                 Grid.Column="1"
                 Margin="10,0,0,0"
                 Padding="5"
                 HorizontalContentAlignment="Left"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas, Microsoft YaHei"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Text="{Binding SelectedSegments.Content, Mode=OneWay}"
                 TextBlock.LineHeight="18" />
    </Grid>
</wpf:ChromeWindow>
