<wpf:ChromeWindow x:Class="LSIC.App.Views.PopLogColumnSelectView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.ChartViewText}}"
                  Width="320"
                  Height="480"
                  d:DataContext="{d:DesignInstance app:LogRule}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource DefaultCornerRadius}">
            <ItemsControl x:Name="ColumnList"
                          Margin="10"
                          ItemsSource="{Binding Columns}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,0,10"
                                  Content="{Binding Header}"
                                  IsEnabled="{Binding Plotable}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Button Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Click="OnConfirmButtonClick"
                Style="{StaticResource Button.Confirm}" />
        <Button Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Click="OnCancelButtonClick"
                Style="{StaticResource Button.Cancel}" />
    </Grid>
</wpf:ChromeWindow>
