<wpf:ChromeWindow x:Class="LSIC.App.Views.PopTriggerSetView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.TriggerSetText}}"
                  MinWidth="220"
                  d:DataContext="{d:DesignInstance vms:PopTriggerSetViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.ZoneText}}" />
                <Run Text=":" />
            </TextBlock>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Zones}"
                      SelectedValue="{Binding SelectedZone}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                    <Binding Path="ZoneFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                    <Binding Path="Id" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.TypeText}}" />
                <Run Text=":" />
            </TextBlock>
            <ComboBox Grid.Row="2"
                      Grid.Column="2"
                      DisplayMemberPath="Value"
                      ItemsSource="{Binding Source={x:Type app:TriggerOutputType}, Converter={StaticResource EnumToTextPairsConverter}}"
                      SelectedValue="{Binding SelectedOutputType}"
                      SelectedValuePath="Key" />

            <TextBlock Grid.Row="4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.DrText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="4"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding Dr, Converter={StaticResource IntegerToIntegerConverter}, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Button Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource Button.Confirm}" />
        <Button Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Cancel}" />
    </Grid>
</wpf:ChromeWindow>
