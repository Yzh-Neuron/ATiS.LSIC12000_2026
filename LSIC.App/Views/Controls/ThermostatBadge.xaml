<UserControl x:Class="LSIC.App.Views.ThermostatBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:LSIC.App.Views"
             xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Foreground="Black"
             mc:Ignorable="d">
    <UserControl.Style>
        <Style BasedOn="{StaticResource Control.Base}" TargetType="{x:Type UserControl}">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="wpf:BorderHelper.CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding wpf:BorderHelper.CornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource ValidationErrorsToStringConverter}">
                                <Binding Path="(Validation.Errors)" RelativeSource="{RelativeSource Self}" />
                                <Binding FallbackValue="{x:Null}"
                                         Path="(Validation.Errors)/"
                                         RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <wpf:SimplePanel>
        <TextBlock x:Name="DisabledTextBlock"
                   Text="N/A"
                   Visibility="Collapsed" />

        <TextBlock x:Name="EnabledTextBlock"
                   Text="{Binding Temperature, RelativeSource={RelativeSource AncestorType={x:Type views:ThermostatBadge}}, Converter={StaticResource IntegerToDecimalConverter10}, StringFormat={}{0}℃}"
                   Visibility="Collapsed" />
    </wpf:SimplePanel>
</UserControl>
