<wpf:ChromeWindow x:Class="LSIC.App.Views.PopDeviceInfoView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.DeviceInfoText}}"
                  Width="760"
                  Height="520"
                  d:DataContext="{d:DesignInstance vms:PopDeviceInfoViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      Width="100"
                      ItemsSource="{Binding Zones}"
                      SelectedItem="{Binding SelectedZone}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse x:Name="PART_State"
                                     Width="11"
                                     Height="11"
                                     Stroke="{Binding ElementName=PART_Text, Path=Foreground, Mode=OneWay}">
                                <Ellipse.Fill>
                                    <MultiBinding Converter="{StaticResource ZoneStateToBrushConverter}">
                                        <Binding Mode="OneWay" Path="State" />
                                        <Binding Mode="OneWay"
                                                 Path="ThemeType"
                                                 Source="{x:Static models:Device.Instance}" />
                                    </MultiBinding>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="PART_Text" Margin="5,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="ZoneFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                        <Binding Path="Id" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="1"
                       MaxWidth="200"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedZone.State, Converter={StaticResource EnumToTextConverter}}">
                <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource ZoneStateToBrushConverter}">
                        <Binding Mode="OneWay" Path="SelectedZone.State" />
                        <Binding Mode="OneWay"
                                 Path="ThemeType"
                                 Source="{x:Static models:Device.Instance}" />
                    </MultiBinding>
                </TextBlock.Foreground>
            </TextBlock>

            <Button Grid.Column="3"
                    Margin="5,0,0,0"
                    wpf:IconHelper.Geometry="{StaticResource Geometry.QueryVersion}"
                    wpf:IconHelper.Height="12"
                    wpf:IconHelper.Width="12"
                    Command="{Binding QueryVersionCommand}"
                    Content="{app:Lang {x:Static app:LangKey.GetVersionInfoText}}" />
            <Button Grid.Column="4"
                    Margin="5,0,0,0"
                    wpf:IconHelper.Geometry="{StaticResource Geometry.ExportCSV}"
                    wpf:IconHelper.Height="12"
                    wpf:IconHelper.Width="12"
                    Command="{Binding ExportCommand}"
                    Content="{app:Lang {x:Static app:LangKey.ExportVersionInfoText}}" />
        </Grid>

        <DataGrid Grid.Row="1"
                  Margin="0,10,0,0"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding SelectedZone.Boards}">
            <DataGrid.Columns>
                <DataGridTextColumn MinWidth="80"
                                    Binding="{Binding DisplayName}"
                                    Header="{app:Lang {x:Static app:LangKey.BoardTypeText}}" />
                <DataGridTextColumn MinWidth="40"
                                    Binding="{Binding Id}"
                                    Header="Id" />
                <DataGridTemplateColumn MinWidth="60" Header="{app:Lang {x:Static app:LangKey.BoardIndexText}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="ParentText" Text="{Binding ParentId}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasParent}" Value="False">
                                    <Setter TargetName="ParentText" Property="Text" Value="-" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*"
                                    MinWidth="100"
                                    Binding="{Binding PN}"
                                    Header="PN" />
                <DataGridTextColumn Width="*"
                                    MinWidth="100"
                                    Binding="{Binding SN}"
                                    Header="SN" />
                <DataGridTextColumn Width="*"
                                    MinWidth="70"
                                    Binding="{Binding HardwareVersion}"
                                    Header="{app:Lang {x:Static app:LangKey.HardwareVersionText}}" />
                <DataGridTemplateColumn Width="*"
                                        MinWidth="240"
                                        Header="{app:Lang {x:Static app:LangKey.FirmwareVersionText}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          FontSize="10"
                                          IsHitTestVisible="False"
                                          ItemsSource="{Binding Firmwares}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,16,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.RowSpan="2"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Type}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Version, Converter={StaticResource IntegerToVersionConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</wpf:ChromeWindow>
