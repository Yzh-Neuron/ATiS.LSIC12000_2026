<wpf:ChromeWindow x:Class="LSIC.App.Views.PopDpsSettingEditView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.DpsEditText}}"
                  MinWidth="350"
                  d:DataContext="{d:DesignInstance vms:PopDpsSettingEditViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.DpsText}}" />
                <Run Text=":" />
            </TextBlock>
            <ComboBox Grid.Column="2"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding DpsInfos}"
                      SelectedValue="{Binding DpsSetting.DpsInfo, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.SetVoltageWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="2"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Vol, Converter={StaticResource IntegerToDecimalConverter1000}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="V"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.VolRange" />
                        <Binding Path="DpsSetting.Vol" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.VoltageCeilingWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="4"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Ovp, Converter={StaticResource IntegerToDecimalConverter1000}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="4"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="V"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.VolLimitRange" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="6"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.VoltageFloorWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="6"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Uvp, Converter={StaticResource IntegerToDecimalConverter1000}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="6"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="V"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.VolLimitRange" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>



            <TextBlock Grid.Row="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.CurrentCeilingWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="8"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Ocp, Converter={StaticResource IntegerToDecimalConverter1000}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="8"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="A"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.CurRange" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.RaiseTimeWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="10"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Raise, Converter={StaticResource IntegerToIntegerConverter}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="10"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="s"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.RiseRange" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.DelayWithUnitText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBox Grid.Row="12"
                     Grid.Column="2"
                     wpf:TextBoxHelper.SelectAllOnGotFocus="True"
                     Text="{Binding DpsSetting.Delay, Converter={StaticResource IntegerToIntegerConverter}, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="12"
                       Grid.Column="4"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource RangeToStringConverter}"
                                  ConverterParameter="s"
                                  StringFormat="{}({0})">
                        <Binding Path="DpsSetting.DpsInfo.DelayRange" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
        <Button Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource Button.Confirm}" />
        <Button Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Cancel}" />
    </Grid>
</wpf:ChromeWindow>
