<Grid x:Class="LSIC.App.Views.CtrZoneBlockView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="clr-namespace:LSIC.App"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="clr-namespace:LSIC.App.Models"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:views="clr-namespace:LSIC.App.Views"
      xmlns:vms="clr-namespace:LSIC.App.ViewModels"
      xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      d:DataContext="{d:DesignInstance models:Zone}"
      d:DesignHeight="80"
      d:DesignWidth="200"
      mc:Ignorable="d">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0"
            wpf:BorderHelper.CornerRadius="{StaticResource DefaultCornerRadius}"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding (wpf:BorderHelper.CornerRadius), RelativeSource={RelativeSource Self}, Converter={StaticResource CornerRadiusSplitConverter}, ConverterParameter='1,0,0,1'}" />
    <Border Grid.Column="1"
            wpf:BorderHelper.CornerRadius="{StaticResource DefaultCornerRadius}"
            Background="{DynamicResource SecondBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,1,1"
            CornerRadius="{Binding (wpf:BorderHelper.CornerRadius), RelativeSource={RelativeSource Self}, Converter={StaticResource CornerRadiusSplitConverter}, ConverterParameter='0,1,1,0'}" />
    <wpf:SimplePanel>
        <Ellipse x:Name="PART_StateRing"
                 Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}"
                 Margin="10"
                 d:Stroke="LimeGreen"
                 Stroke="{Binding State, Converter={StaticResource ZoneStateToBrushConverter}}"
                 StrokeThickness="6" />

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   d:Text="1"
                   FontFamily="{StaticResource Fonts.MapleMono}"
                   Foreground="#444"
                   Text="{Binding Id, StringFormat=D2}" />

    </wpf:SimplePanel>


    <TextBlock Grid.Column="2"
               HorizontalAlignment="Center"
               d:Text="离线"
               wpf:LanguageHelper.Auto="True"
               FontSize="13"
               Text="{Binding State, Converter={StaticResource EnumToTextConverter}}" />


    <Path Grid.Column="2"
          Width="15"
          Height="15"
          Margin="0,5,5,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Data="{StaticResource Geometry.DoubleRing}"
          Fill="{Binding ElementName=PART_StateRing, Path=Stroke}"
          Stretch="Uniform"
          Visibility="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem, AncestorLevel=1}, Path=IsSelected, Converter={StaticResource TrueToVisibilityConverter}}" />


    <ToggleButton Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  wpf:IconHelper.CheckedGeometry="{StaticResource Geometry.SlotUninserted}"
                  wpf:IconHelper.Geometry="{StaticResource Geometry.SlotInserted}"
                  wpf:IconHelper.Height="15"
                  wpf:IconHelper.Width="15"
                  Foreground="{DynamicResource SecondForegroundBrush}"
                  Style="{StaticResource ToggleButton.Icon}" />
</Grid>
