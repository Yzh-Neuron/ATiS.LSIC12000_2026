<Grid x:Class="LSIC.App.Views.CtrBurnInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="clr-namespace:LSIC.App"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:decos="clr-namespace:LSIC.App.Decorators"
      xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="clr-namespace:LSIC.App.Models"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:views="clr-namespace:LSIC.App.Views"
      xmlns:vms="clr-namespace:LSIC.App.ViewModels"
      xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      d:DataContext="{d:DesignInstance vms:CtrBurnInfoViewModel}"
      d:DesignHeight="500"
      d:DesignWidth="300"
      mc:Ignorable="d">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  老化时间  -->
    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="5" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ThirdBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{app:Lang {x:Static app:LangKey.CurrentPatternSetTimeText}}" />
                <TextBlock Grid.Row="1"
                           Margin="0,5,0,0"
                           FontSize="20"
                           Text="{Binding Zone.BurnInfo.RunInfo.Progress.Total, Converter={StaticResource TimeSecondToTimeStringConverter}}" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource ThirdBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{app:Lang {x:Static app:LangKey.CurrentPatternCostTimeText}}" />
                <TextBlock Grid.Row="1"
                           Margin="0,5,0,0"
                           FontSize="20"
                           Text="{Binding Zone.BurnInfo.RunInfo.Progress.Cost, Converter={StaticResource TimeSecondToTimeStringConverter}}" />
            </Grid>
        </Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="5" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ThirdBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{app:Lang {x:Static app:LangKey.CurrentPatternLeftTimeText}}" />
                <TextBlock Grid.Row="1"
                           Margin="0,5,0,0"
                           FontSize="20"
                           Text="{Binding Zone.BurnInfo.RunInfo.Progress.Left, Converter={StaticResource TimeSecondToTimeStringConverter}}" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource ThirdBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{app:Lang {x:Static app:LangKey.TotalTimeBeforeDpsUpText}}" />
                <TextBlock Grid.Row="1"
                           Margin="0,5,0,0"
                           FontSize="20"
                           Text="{Binding Zone.BurnInfo.TotalSeconds, Converter={StaticResource TimeSecondToTimeStringConverter}}" />
            </Grid>
        </Border>
    </Grid>

    <!--  循环状态  -->
    <Border Grid.Row="2"
            Height="48"
            Margin="0,10,0,0"
            Padding="5"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}"
            Visibility="{Binding Zone.BurnInfo.LoopInfo.Enable, Converter={StaticResource TrueToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Text="{DynamicResource RunInTheLoopText}" />
                <TextBlock Margin="6,0,0,0">
                    <Run Text="{Binding Zone.BurnInfo.LoopInfo.Start.Name, Mode=OneWay}" />
                    <Run Text="→" />
                    <Run Text="{Binding Zone.BurnInfo.LoopInfo.End.Name, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding Zone.BurnInfo.LoopInfo.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter={x:Static app:ExecuteMode.Time}}">
                <Run Text="(" />
                <Run Text="{Binding Zone.BurnInfo.LoopInfo.Progress.Cost, Mode=OneWay, Converter={StaticResource SecondsToTimeSpanStringConverter}}" />
                <Run Text="/" />
                <Run Text="{Binding Zone.BurnInfo.LoopInfo.Progress.Total, Mode=OneWay, Converter={StaticResource SecondsToTimeSpanStringConverter}}" />
                <Run Text=")" />
            </TextBlock>
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Visibility="{Binding Zone.BurnInfo.LoopInfo.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter={x:Static app:ExecuteMode.Times}}">
                <Run Text="(" />
                <Run Text="{Binding Zone.BurnInfo.LoopInfo.Progress.Cost, Mode=OneWay, Converter={StaticResource LinerChangeConverter}, ConverterParameter='1|0'}" />
                <Run Text="/" />
                <Run Text="{Binding Zone.BurnInfo.LoopInfo.Progress.Total, Mode=OneWay}" />
                <Run Text=")" />
            </TextBlock>
        </Grid>

    </Border>

    <!--  老化详情  -->
    <Border Grid.Row="3"
            Margin="0,10,0,0"
            Background="{DynamicResource ThirdBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <decos:GridLineDecorator GridLineBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.CurrentIcText}}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.Ic.Name}" />

                <TextBlock Grid.Row="1"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.LotText}}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.Lot}" />

                <TextBlock Grid.Row="2"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.OperatorText}}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.Operator}" />

                <TextBlock Grid.Row="3"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.LoadModeText}}" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.LoadMode, Converter={StaticResource EnumToTextConverter}}" />

                <TextBlock Grid.Row="4"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.StartTimeText}}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.Start, StringFormat='yyyy-MM-dd HH:mm:ss'}" />

                <TextBlock Grid.Row="5"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.CurrentDpsPlanText}}" />
                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.CurrentDpsPlan.Name}" />

                <TextBlock Grid.Row="6"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.CurrentStepText}}" />
                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding Zone.BurnInfo.CurrentStep.Name}" />

                <TextBlock Grid.Row="7"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.CurrentPatternText}}" />
                <TextBlock Grid.Row="7"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Text="{Binding Zone.BurnInfo.CurrentVector.PatternFile}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Zone.BurnInfo.CurrentVector.PatternFile}" />

                <TextBlock Grid.Row="8"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{app:Lang {x:Static app:LangKey.CurrentRegistersText}}" />
                <DockPanel Grid.Row="8"
                           Grid.Column="1"
                           LastChildFill="False">
                    <TextBlock MaxWidth="350"
                               Margin="10,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               DockPanel.Dock="Left"
                               Text="{Binding Zone.BurnInfo.CurrentVector.RegisterFile}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Zone.BurnInfo.CurrentVector.RegisterFile}" />
                    <Button Margin="5,0,0,0"
                            Click="OnViewRegisterFileButtonClick"
                            Content="{app:Lang {x:Static app:LangKey.ViewText}}"
                            DockPanel.Dock="Left"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource Button.Link}"
                            Tag="{Binding Zone.BurnInfo.CurrentVector.RegisterFile}"
                            Visibility="{Binding Zone.BurnInfo.CurrentVector, Converter={StaticResource NotNullToVisibilityConverter}}" />
                </DockPanel>
            </Grid>
        </decos:GridLineDecorator>
    </Border>

    <!--  发送进度  -->
    <ProgressBar Grid.Row="4"
                 Margin="0,10,0,0"
                 Tag="{Binding Zone.State, Converter={StaticResource ZoneStateToSending}}"
                 Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TrueToVisibilityConverter}}"
                 Maximum="100"
                 Value="{Binding Zone.BurnInfo.SendProcess}" />

    <!--  操作按钮  -->
    <WrapPanel Grid.Row="5"
               Margin="0,10,0,0"
               ItemHeight="31"
               Orientation="Horizontal">
        <Button Margin="0,0,5,0"
                VerticalAlignment="Top"
                wpf:IconHelper.Geometry="{StaticResource Geometry.SendPara}"
                wpf:IconHelper.Height="13"
                wpf:IconHelper.Width="13"
                Command="{Binding SendIcCommand}"
                Content="{app:Lang {x:Static app:LangKey.SendParameterText}}"
                Tag="{Binding Zone.State, Converter={StaticResource ZoneStateToCanSendIc}}"
                Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TrueToVisibilityConverter}}" />

        <Button Margin="0,0,5,0"
                VerticalAlignment="Top"
                wpf:IconHelper.Geometry="{StaticResource Geometry.StartBurn}"
                wpf:IconHelper.Height="13"
                wpf:IconHelper.Width="13"
                Command="{Binding StartCommand}"
                Content="{app:Lang {x:Static app:LangKey.StartBurnText}}"
                Tag="{Binding Zone.State, Converter={StaticResource ZoneStateToCanStart}}"
                Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TrueToVisibilityConverter}}" />

        <Button Margin="0,0,5,0"
                VerticalAlignment="Top"
                wpf:IconHelper.Geometry="{StaticResource Geometry.StopBurn}"
                wpf:IconHelper.Height="13"
                wpf:IconHelper.Width="13"
                Command="{Binding StopCommand}"
                Content="{app:Lang {x:Static app:LangKey.StopBurnText}}"
                Tag="{Binding Zone.State, Converter={StaticResource ZoneStateToCanStop}}"
                Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TrueToVisibilityConverter}}" />

        <Button Margin="0,0,5,0"
                VerticalAlignment="Top"
                wpf:IconHelper.Geometry="{StaticResource Geometry.ReSelectIc}"
                wpf:IconHelper.Height="13"
                wpf:IconHelper.Width="13"
                Command="{Binding ClearBurnInfoCommand}"
                Content="{app:Lang {x:Static app:LangKey.ReSelectIcText}}"
                Tag="{Binding Zone.State, Converter={StaticResource ZoneStateToRunning}}"
                Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource FalseToVisibilityConverter}}" />
    </WrapPanel>
</Grid>

