<wpf:ChromeWindow x:Class="LSIC.App.Views.WinStartupView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="WinStartupView"
                  Width="380"
                  Height="520"
                  d:DataContext="{d:DesignInstance vms:WinStartupViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  IsShowTitleBar="False"
                  ResizeMode="NoResize"
                  TitleBarHeight="60"
                  WindowStartupLocation="CenterScreen"
                  mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate x:Key="LogoDataTemplate">
            <Grid Height="96"
                  HorizontalAlignment="Center"
                  TextBlock.FontSize="80"
                  TextBlock.FontWeight="Medium">
                <Grid.Resources>
                    <PathGeometry x:Key="DotPath">
                        <PathFigure StartPoint="84 48">
                            <ArcSegment IsLargeArc="False"
                                        Point="6 12"
                                        Size="60 60"
                                        SweepDirection="Clockwise" />
                            <ArcSegment IsLargeArc="False"
                                        Point="52 4"
                                        Size="30 30"
                                        SweepDirection="Clockwise" />
                            <ArcSegment IsLargeArc="False"
                                        Point="146 2.5"
                                        Size="70 70"
                                        SweepDirection="Clockwise" />
                            <ArcSegment IsLargeArc="False"
                                        Point="108 9"
                                        Size="40 100"
                                        SweepDirection="Counterclockwise" />
                        </PathFigure>
                    </PathGeometry>

                    <Storyboard x:Key="DotStoryboard">
                        <DoubleAnimation Storyboard.TargetName="Dot"
                                         Storyboard.TargetProperty="(FrameworkElement.Height)"
                                         To="16"
                                         Duration="0:0:1.6" />
                        <DoubleAnimation Storyboard.TargetName="Dot"
                                         Storyboard.TargetProperty="(FrameworkElement.Width)"
                                         To="16"
                                         Duration="0:0:1.6" />
                        <DoubleAnimationUsingPath PathGeometry="{StaticResource DotPath}"
                                                  Source="X"
                                                  Storyboard.TargetName="Dot"
                                                  Storyboard.TargetProperty="(Canvas.Left)"
                                                  Duration="0:0:4" />
                        <DoubleAnimationUsingPath PathGeometry="{StaticResource DotPath}"
                                                  Source="Y"
                                                  Storyboard.TargetName="Dot"
                                                  Storyboard.TargetProperty="(Canvas.Top)"
                                                  Duration="0:0:4" />
                    </Storyboard>

                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="FontFamily" Value="{StaticResource Fonts.Roboto}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    </Style>
                </Grid.Resources>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Control.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource DotStoryboard}" />
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="A" />
                <TextBlock Grid.Column="1" Text="T" />
                <Rectangle Grid.Column="2"
                           Width="10"
                           Height="40"
                           Margin="12,0,12,25"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource PrimaryBrush}" />
                <TextBlock Grid.Column="4" Text="S" />
                <Border Grid.Column="5"
                        Width="14"
                        Height="14"
                        Margin="0,18,0,0"
                        VerticalAlignment="Top"
                        BorderBrush="Black"
                        BorderThickness="1.2"
                        CornerRadius="7">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="Black"
                               Text="R" />
                </Border>
                <Canvas Grid.Column="0" Grid.ColumnSpan="4">
                    <Ellipse x:Name="Dot"
                             Canvas.Left="50"
                             Canvas.Top="20"
                             Width="60"
                             Height="60"
                             Fill="Red" />
                </Canvas>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CheckItemDataTemplate" DataType="{x:Type models:CheckItem}">
            <Grid Width="270" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12.6"
                           FontWeight="Black"
                           Text="{Binding Name}" />
                <Border Grid.Column="2" Margin="0,5">
                    <ContentControl x:Name="PART_Content" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="{x:Null}">
                    <Setter TargetName="PART_Content" Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <wpf:LoadingCircle Width="20"
                                                   Height="20"
                                                   DotCount="6"
                                                   DotDelayTime="100"
                                                   DotDiameter="3.6"
                                                   DotInterval="20"
                                                   DotOffSet="60"
                                                   DotSpeed="4"
                                                   Foreground="{DynamicResource SecondForegroundBrush}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                    <Setter TargetName="PART_Content" Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1.9166054,8.2930691 A 0.88553157,0.88553157 0 1 0 0.66575293,9.5468764 L 6.6781036,15.540347 16.16924,4.1115655 A 0.88512236,0.88512236 0 1 0 14.807462,2.9804921 L 6.5541982,12.918272 Z"
                                      Fill="{DynamicResource SuccessBrush}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Connected}" Value="False">
                    <Setter TargetName="PART_Content" Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 7.8697429,7.0002879 13.807811,1.0617387 A 0.61557088,0.61511068 0 1 0 12.937262,0.19184115 L 6.9998112,6.1303905 1.0617435,0.19122485 A 0.61557066,0.61511047 0 1 0 0.19119516,1.0611224 L 6.1292628,6.9996716 0.19119516,12.938221 A 0.61557068,0.61511048 0 1 0 1.0617435,13.808118 L 6.9998112,7.8695691 12.937262,13.808118 a 0.61557068,0.61511049 0 1 0 0.870549,-0.869897 L 7.8697429,7.0002879 v 9.8e-6 z"
                                      Fill="{DynamicResource ErrorBrush}" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Border Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="95" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Border Background="Transparent" />
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentControl ContentTemplate="{StaticResource LogoDataTemplate}" FocusVisualStyle="{x:Null}" />
                <TextBlock Margin="0,10"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Text="{app:Lang {x:Static app:LangKey.ConceptText}}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="10,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource SecondForegroundBrush}"
                           Text="{app:Lang {x:Static app:LangKey.SloganText}}"
                           TextAlignment="Justify"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Image Grid.Row="1"
                   Opacity=".32"
                   Source="{StaticResource TechnologyImage}" />

            <ListBox Grid.Row="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"
                     ItemTemplate="{StaticResource CheckItemDataTemplate}"
                     ItemsSource="{Binding CheckItems}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Style="{x:Null}">
                <i:Interaction.Behaviors>
                    <wpf:ListBoxScrollToBottomBehavior />
                </i:Interaction.Behaviors>
            </ListBox>
        </Grid>
    </Border>
</wpf:ChromeWindow>
