<Grid x:Class="LSIC.App.Views.CtrHomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="clr-namespace:LSIC.App"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="clr-namespace:LSIC.App.Models"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:views="clr-namespace:LSIC.App.Views"
      xmlns:vms="clr-namespace:LSIC.App.ViewModels"
      xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      d:DataContext="{d:DesignInstance vms:CtrHomeViewModel}"
      d:Height="1080"
      d:Width="1920"
      mc:Ignorable="d">
    <Grid.Resources>
        <views:CtrHomeViewModelProxy x:Key="MainDataContext" Data="{Binding}" />
    </Grid.Resources>
    <TabControl BorderThickness="1"
                ItemContainerStyle="{StaticResource TabItem.Zone}"
                ItemsSource="{Binding Zones}"
                SelectedIndex="0"
                SelectedItem="{Binding CurrentZone}"
                Style="{StaticResource TabControl.Zone}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Path x:Name="PART_Icon"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Center"
                          Data="{StaticResource RunIcon}"
                          Fill="{Binding State, Converter={StaticResource ZoneStateToBrushConverter}}"
                          Stretch="Uniform" />
                    <TextBlock x:Name="PART_ZoneName"
                               Grid.Row="1"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Id, Mode=OneWay}" />
                        <Run Text="{app:Lang {x:Static app:LangKey.ZoneText}}" />
                    </TextBlock>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding BurnInfo}" Value="{x:Null}">
                        <Setter TargetName="PART_Icon" Property="Data" Value="{StaticResource RestIcon}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate DataType="{x:Type models:Zone}">
                <Grid x:Name="MainRegion">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" MaxWidth="600" />
                        <ColumnDefinition Width="10*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4,0,0,4">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <!--  单区状态  -->
                            <Grid Margin="0,0,0,10"
                                  TextBlock.FontSize="13"
                                  TextBlock.FontWeight="Bold"
                                  TextBlock.Foreground="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{Binding State, Converter={StaticResource ZoneStateToBrushConverter}}"
                                        BorderBrush="{DynamicResource ForegroundBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <TextBlock Grid.Column="0"
                                               Margin="10,0,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                <Binding Path="ZoneFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>

                                <wpf:SimplePanel Grid.Column="1" Margin="5,0,0,0">
                                    <Border Background="{Binding State, Converter={StaticResource ZoneStateToBrushConverter}}"
                                            BorderBrush="{DynamicResource ForegroundBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock FontSize="13">
                                                <Run Text="{app:Lang {x:Static app:LangKey.StateText}}" />
                                                <Run Text="：" />
                                            </TextBlock>
                                            <TextBlock wpf:LanguageHelper.Auto="True"
                                                       FontSize="13"
                                                       Text="{Binding State, Converter={StaticResource EnumToTextConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <ToggleButton Grid.Column="2"
                                                  Margin="0,0,5,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Stretch"
                                                  wpf:IconHelper.CheckedGeometry="{StaticResource Geometry.SlotInserted}"
                                                  wpf:IconHelper.Geometry="{StaticResource Geometry.SlotUninserted}"
                                                  wpf:IconHelper.Height="15"
                                                  wpf:IconHelper.Width="15"
                                                  Background="{DynamicResource SecondBackgroundBrush}"
                                                  BorderBrush="{DynamicResource ForegroundBrush}"
                                                  BorderThickness="1"
                                                  IsChecked="{Binding Pluged, Mode=OneWay}"
                                                  IsHitTestVisible="False">
                                        <ToggleButton.Style>
                                            <Style BasedOn="{StaticResource ToggleButton.Icon}" TargetType="{x:Type ToggleButton}">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="Green" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </wpf:SimplePanel>
                            </Grid>

                            <!--  准备老化  -->
                            <views:CtrPrepareBurnView Grid.Row="1"
                                                      d:DataContext="{d:DesignInstance vms:CtrPrepareBurnViewModel}"
                                                      Visibility="{Binding Zone.BurnInfo, Converter={StaticResource NullToVisibilityConverter}}"
                                                      Zone="{Binding ElementName=MainRegion, Path=DataContext}" />

                            <!--  老化信息  -->
                            <views:CtrBurnInfoView Grid.Row="1"
                                                   d:DataContext="{d:DesignInstance vms:CtrBurnInfoViewModel}"
                                                   Visibility="{Binding Zone.BurnInfo, Converter={StaticResource NotNullToVisibilityConverter}}"
                                                   Zone="{Binding ElementName=MainRegion, Path=DataContext}" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Column="1"
                                wpf:BorderHelper.CornerRadius="0,4,4,0"
                                wpf:TabControlHelper.HasSeparator="True"
                                wpf:TabControlHelper.HeaderHeight="90"
                                wpf:TabControlHelper.HeaderPanelBackground="{DynamicResource BackgroundBrush}"
                                wpf:TabControlHelper.HeaderWidth="36"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,1,1"
                                TabStripPlacement="Right">

                        <!--  电源监控  -->
                        <TabItem Visibility="{Binding BurnInfo, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical">
                                    <Image Width="16" Source="{StaticResource Image.Monitor}" />
                                    <TextBlock MaxWidth="12"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{app:Lang {x:Static app:LangKey.DpsText}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem.Header>
                            <views:CtrDpsView />
                        </TabItem>

                        <!--  老化板  -->
                        <TabItem Visibility="{Binding BurnInfo, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical">
                                    <Image Width="16" Source="{StaticResource Image.Dut}" />
                                    <TextBlock MaxWidth="12"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{app:Lang {x:Static app:LangKey.Enum_BoardType_BurnInBoard}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem.Header>
                            <views:CtrBurnInBoardView BurnInBoard="{Binding ElementName=MainRegion, Path=DataContext.BurnInfo.BurnInBoard, Mode=OneWay}" />
                        </TabItem>

                        <!--  日志  -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical">
                                    <Image Width="16" Source="{StaticResource Image.LogViewer}" />
                                    <TextBlock MaxWidth="12"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{app:Lang {x:Static app:LangKey.LogText}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem.Header>
                            <views:CtrFlowLogView Logger="{Binding Logger, Mode=OneWay}" />
                        </TabItem>

                        <TabControl.Style>
                            <Style BasedOn="{StaticResource {x:Type TabControl}}" TargetType="{x:Type TabControl}">
                                <Setter Property="SelectedIndex" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BurnInfo}" Value="{x:Null}">
                                        <Setter Property="SelectedIndex" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Style>
                    </TabControl>
                </Grid>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</Grid>
