<wpf:ChromeWindow x:Class="LSIC.App.Views.PopDeviceCheckView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.DeviceCheckText}}"
                  Width="600"
                  Height="640"
                  d:DataContext="{d:DesignInstance vms:PopDeviceCheckViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      Width="100"
                      ItemsSource="{Binding Zones}"
                      SelectedItem="{Binding SelectedZone}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse x:Name="PART_State"
                                     Width="11"
                                     Height="11"
                                     Stroke="{Binding ElementName=PART_Text, Path=Foreground, Mode=OneWay}">
                                <Ellipse.Fill>
                                    <MultiBinding Converter="{StaticResource ZoneStateToBrushConverter}">
                                        <Binding Mode="OneWay" Path="State" />
                                        <Binding Mode="OneWay"
                                                 Path="ThemeType"
                                                 Source="{x:Static models:Device.Instance}" />
                                    </MultiBinding>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="PART_Text" Margin="10,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                        <Binding Path="ZoneFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                        <Binding Path="Id" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedZone.State, Converter={StaticResource EnumToTextConverter}}">
                <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource ZoneStateToBrushConverter}">
                        <Binding Mode="OneWay" Path="SelectedZone.State" />
                        <Binding Mode="OneWay"
                                 Path="ThemeType"
                                 Source="{x:Static models:Device.Instance}" />
                    </MultiBinding>
                </TextBlock.Foreground>
            </TextBlock>
            <Button Grid.Column="2"
                    wpf:IconHelper.Geometry="{StaticResource Geometry.SelfCheck}"
                    wpf:IconHelper.Height="12"
                    wpf:IconHelper.Width="12"
                    Command="{Binding StartCommand}"
                    Content="{app:Lang {x:Static app:LangKey.StartDeviceCheckText}}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="10"
                           FontWeight="SemiBold"
                           Text="{app:Lang {x:Static app:LangKey.DeviceCheckResultText}}" />

                <Rectangle Grid.Row="1"
                           Margin="10,1"
                           Stroke="{DynamicResource BorderBrush}"
                           StrokeDashArray="3 3"
                           StrokeThickness="1" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="10,0,10,10" ItemsSource="{Binding SelectedZone.DeviceCheckItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon"
                                               Grid.Column="0"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Text="&#x2713;" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                        <Setter TargetName="Icon" Property="Text" Value="&#x2717;" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</wpf:ChromeWindow>
