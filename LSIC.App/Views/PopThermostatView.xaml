<wpf:ChromeWindow x:Class="LSIC.App.Views.PopThermostatView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:oxy="http://oxyplot.org/wpf"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.ThermostatMonitorText}}"
                  Width="900"
                  Height="620"
                  d:DataContext="{d:DesignInstance vms:PopThermostatViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Dut_List"
                 ItemsSource="{Binding Duts}"
                 SelectedItem="{Binding SelectedDut}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse x:Name="PART_State"
                                 Width="8"
                                 Height="8"
                                 Fill="{Binding State, Converter={StaticResource DutStateToBrushConverter}}" />
                        <TextBlock x:Name="PART_Text" Margin="5,0,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                    <Binding Path="DutFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                    <Binding Path="Id" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1"
              Margin="10,0,0,0"
              Visibility="{Binding SelectedThermostat, Converter={StaticResource NotNullToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroups" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="{app:Lang {x:Static app:LangKey.ThermostatIndexText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.Id, Mode=OneWay, TargetNullValue='N/A'}" />
                    </Grid>
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}" />
                    <Grid Grid.Column="2" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroups" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="{app:Lang {x:Static app:LangKey.RealTemperatureText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.Temperature, Converter={StaticResource IntegerToDecimalConverter10}, Mode=OneWay, TargetNullValue='N/A', StringFormat={}{0} ℃}" />
                    </Grid>
                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}" />
                    <Grid Grid.Column="4" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroups" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="{app:Lang {x:Static app:LangKey.TargetTemperatureText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.TargetTemperature, Converter={StaticResource IntegerToDecimalConverter10}, Mode=OneWay, TargetNullValue='N/A', StringFormat={}{0} ℃}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DefaultCornerRadius}">
                <oxy:Plot Margin="10,10,20,10"
                          Background="Transparent"
                          IsLegendVisible="True">
                    <oxy:Plot.Axes>
                        <oxy:LinearAxis MajorGridlineColor="#10000000"
                                        MajorGridlineStyle="Solid"
                                        MajorGridlineThickness="1"
                                        Maximum="200"
                                        Minimum="0"
                                        MinorGridlineColor="#08000000"
                                        MinorGridlineStyle="Solid"
                                        MinorGridlineThickness="1"
                                        Position="Left" />
                        <oxy:DateTimeAxis FirstDateTime="{Binding SelectedThermostat.ChartDataTimeRange.Start}"
                                          LastDateTime="{Binding SelectedThermostat.ChartDataTimeRange.End}"
                                          MajorGridlineColor="#10000000"
                                          MajorGridlineStyle="Solid"
                                          MajorGridlineThickness="1"
                                          MinorGridlineColor="#08000000"
                                          MinorGridlineStyle="Solid"
                                          MinorGridlineThickness="1"
                                          Position="Bottom" />
                    </oxy:Plot.Axes>
                    <oxy:Plot.Series>
                        <oxy:LineSeries Title="{app:Lang {x:Static app:LangKey.RealTemperatureText}}"
                                        InterpolationAlgorithm="{x:Null}"
                                        ItemsSource="{Binding SelectedThermostat.PvData}"
                                        StrokeThickness="1.5" />
                    </oxy:Plot.Series>
                </oxy:Plot>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="Kp" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 Margin="10,0,0,0"
                                 Text="{Binding Kp, Converter={StaticResource DecimalToDecimalConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.Kp, Mode=OneWay, TargetNullValue='--'}" />
                    </Grid>
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}" />
                    <Grid Grid.Column="2" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="Ki" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 Margin="10,0,0,0"
                                 Text="{Binding Ki, Converter={StaticResource DecimalToDecimalConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.Ki, Mode=OneWay, TargetNullValue='--'}" />
                    </Grid>
                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}" />
                    <Grid Grid.Column="4" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="Kd" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 Margin="10,0,0,0"
                                 Text="{Binding Kd, Converter={StaticResource DecimalToDecimalConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   Text="{Binding SelectedThermostat.Kd, Mode=OneWay, TargetNullValue='--'}" />
                    </Grid>
                    <Rectangle Grid.Column="5"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}" />
                    <Button Grid.Column="6"
                            Command="{Binding SetPidCommand}"
                            Content="{app:Lang {x:Static app:LangKey.SetThermostatCoefficientText}}"
                            Style="{StaticResource Button.Confirm}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</wpf:ChromeWindow>
