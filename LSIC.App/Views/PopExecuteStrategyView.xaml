<wpf:ChromeWindow x:Class="LSIC.App.Views.PopExecuteStrategyView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  MinWidth="350"
                  d:DataContext="{d:DesignInstance vms:PopExecuteStrategyViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,10,0">
                <Run x:Name="modeText" />
                <Run Text=":" />
            </TextBlock>
            <ComboBox Width="100"
                      DisplayMemberPath="Value"
                      ItemsSource="{Binding Source={x:Type app:ExecuteMode}, Converter={StaticResource EnumToTextPairsConverter}, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValue="{Binding ExecuteStrategy.Mode}"
                      SelectedValuePath="Key" />
        </StackPanel>

        <wpf:SimplePanel Grid.Row="2"
                         Grid.ColumnSpan="2"
                         Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ExecuteStrategy.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Time'}">
                <TextBlock Margin="0,0,10,0">
                    <Run x:Name="timeText" />
                    <Run Text=":" />
                </TextBlock>

                <TextBox Width="100" Text="{Binding ExecuteStrategy.Time.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}" />

                <ComboBox Width="75"
                          Margin="5,0,0,0"
                          DisplayMemberPath="Value"
                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                          SelectedValue="{Binding ExecuteStrategy.Time.Unit, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Key" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ExecuteStrategy.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Times'}">
                <TextBlock Margin="0,0,10,0">
                    <Run x:Name="timesText" />
                    <Run Text=":" />
                </TextBlock>
                <TextBox Grid.Column="2"
                         Width="100"
                         Text="{Binding ExecuteStrategy.Count, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}" />
                <TextBlock Margin="5,0,0,0" Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
            </StackPanel>
        </wpf:SimplePanel>

        <Button Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource Button.Confirm}" />


        <Button Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Cancel}" />
    </Grid>
</wpf:ChromeWindow>
