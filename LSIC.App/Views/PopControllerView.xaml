<wpf:ChromeWindow x:Class="LSIC.App.Views.PopControllerView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.ControllerText}}"
                  Width="850"
                  Height="620"
                  d:DataContext="{d:DesignInstance vms:PopControllerViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <wpf:ChromeWindow.Resources>
        <Storyboard x:Key="BreathLight"
                    AutoReverse="True"
                    RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.6" />
        </Storyboard>
    </wpf:ChromeWindow.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Height="31"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="4,0,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroup" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,0,10,0">
                        <Run Text="{app:Lang {x:Static app:LangKey.AlarmLightText}}" />
                        <Run Text=":" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!--  红灯  -->
                        <Border Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Background="Gray"
                                BorderBrush="{DynamicResource SecondBorderBrush}"
                                BorderThickness="1,1,0,1">
                            <Rectangle Fill="Red">
                                <Rectangle.Style>
                                    <Style TargetType="{x:Type Rectangle}">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Red}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Alarming}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Blink" Storyboard="{StaticResource BreathLight}" />
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Blink" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Border>
                        <!--  黄灯  -->
                        <Border Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Background="Gray"
                                BorderBrush="{DynamicResource SecondBorderBrush}"
                                BorderThickness="1">
                            <Rectangle Fill="Orange">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Yellow}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Alarming}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Blink" Storyboard="{StaticResource BreathLight}" />
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Blink" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Border>
                        <!--  绿灯  -->
                        <Border Width="15"
                                Height="15"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="Gray"
                                BorderBrush="{DynamicResource SecondBorderBrush}"
                                BorderThickness="0,1,1,1">
                            <Rectangle Fill="Green">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Green}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Controller.LightAlarm, Converter={StaticResource LightAlarmHasFlagConverter}, ConverterParameter={x:Static app:LightAlarmState.Alarming}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Blink" Storyboard="{StaticResource BreathLight}" />
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Blink" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Visibility="{Binding Device.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Engineering|Administrator'}">
                        <Button Command="{Binding ToggleAlarmLightCommand}"
                                CommandParameter="{x:Static app:LightAlarmState.Red}"
                                Content="{app:Lang {x:Static app:LangKey.Enum_LightAlarmState_Red}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ToggleAlarmLightCommand}"
                                CommandParameter="{x:Static app:LightAlarmState.Yellow}"
                                Content="{app:Lang {x:Static app:LangKey.Enum_LightAlarmState_Yellow}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ToggleAlarmLightCommand}"
                                CommandParameter="{x:Static app:LightAlarmState.Green}"
                                Content="{app:Lang {x:Static app:LangKey.Enum_LightAlarmState_Green}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ToggleAlarmLightCommand}"
                                CommandParameter="{x:Static app:LightAlarmState.Alarming}"
                                Content="{app:Lang {x:Static app:LangKey.Enum_LightAlarmState_Alarming}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Height="31"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroup" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,0,10,0">
                        <Run Text="{app:Lang {x:Static app:LangKey.DoorText}}" />
                        <Run Text=":" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="--" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Controller.DoorOpened}" Value="true">
                                        <Setter Property="Text" Value="{app:Lang {x:Static app:LangKey.DoorOpenedText}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Controller.DoorOpened}" Value="false">
                                        <Setter Property="Text" Value="{app:Lang {x:Static app:LangKey.DoorClosedText}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding Device.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Engineering|Administrator'}">
                        <Button Command="{Binding DoorOpenCommand}"
                                Content="{app:Lang {x:Static app:LangKey.OpenText}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding DoorCloseCommand}"
                                Content="{app:Lang {x:Static app:LangKey.CloseText}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2"
                    Grid.Column="0"
                    Height="31"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="NameGroup" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,0,10,0">
                        <Run Text="{app:Lang {x:Static app:LangKey.WaterChillerText}}" />
                        <Run Text=":" />
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding Controller.ChillerState, Converter={StaticResource EnumToTextConverter}, TargetNullValue='--'}" />
                </Grid>
            </Border>
            <Border Grid.Row="3"
                    Grid.Column="0"
                    Height="31"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="0"
                    Visibility="{Binding Device.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Engineering|Administrator'}">
                <StackPanel Margin="10,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0">
                        <Run Text="{app:Lang {x:Static app:LangKey.WaterChillerAlarmAutoStopBurnInText}}" />
                        <Run Text=":" />
                    </TextBlock>
                    <CheckBox IsChecked="{Binding Controller.StopBurnWhenChillerAlarm, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <ListView x:Name="ZonesList"
                      Grid.Row="4"
                      VerticalAlignment="Top"
                      wpf:BorderHelper.CornerRadius="0"
                      wpf:ListViewHelper.CanUserResizeColumns="False"
                      BorderThickness="1,1,1,0"
                      ItemsSource="{Binding Zones}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedIndex="-1"
                      SelectedItem="{Binding SelectedZone}">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="{Binding ElementName=ZonesList, Path=ActualWidth, Converter={StaticResource ProportionalWidthConverter}, ConverterParameter='1,3'}"
                                        DisplayMemberBinding="{Binding Id}"
                                        Header="{app:Lang {x:Static app:LangKey.ZoneText}}" />
                        <GridViewColumn Width="{Binding ElementName=ZonesList, Path=ActualWidth, Converter={StaticResource ProportionalWidthConverter}, ConverterParameter='1,3'}"
                                        DisplayMemberBinding="{Binding WaterCoolingPipe.FlowRate, StringFormat={}{0:F1}, TargetNullValue='--'}"
                                        Header="{app:Lang {x:Static app:LangKey.FlowRateWithUnitText}}" />
                        <GridViewColumn Width="{Binding ElementName=ZonesList, Path=ActualWidth, Converter={StaticResource ProportionalWidthConverter}, ConverterParameter='1,3'}"
                                        DisplayMemberBinding="{Binding WaterCoolingPipe.ValveFeedback, StringFormat={}{0:F1}, TargetNullValue='--'}"
                                        Header="{app:Lang {x:Static app:LangKey.ValveFeedbackWithUnitText}}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Grid.Row="5"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,0,4">
                <Grid Margin="10,5" Visibility="{Binding SelectedZone, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="31" />
                        <RowDefinition Height="31" />
                        <RowDefinition Height="31" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                            <Run Text="{app:Lang {x:Static app:LangKey.ZoneIndexText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   Text="{Binding SelectedZone.Id}" />

                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                            <Run Text="{app:Lang {x:Static app:LangKey.FlowRateWithUnitText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   Text="{Binding SelectedZone.WaterCoolingPipe.FlowRate, StringFormat={}{0:F1}, TargetNullValue='--'}" />

                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                            <Run Text="{app:Lang {x:Static app:LangKey.ValveFeedbackWithUnitText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   Text="{Binding SelectedZone.WaterCoolingPipe.ValveFeedback, StringFormat={}{0:F1}, TargetNullValue='--'}" />
                    </StackPanel>


                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Visibility="{Binding Device.Mode, Converter={StaticResource IncludeValueToVisibilityConverter}, ConverterParameter='Engineering|Administrator'}">
                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                            <Run Text="{app:Lang {x:Static app:LangKey.ValveControlWithUnitText}}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 Width="100"
                                 VerticalAlignment="Center"
                                 Text="{Binding ValveControl, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Margin="10,0,0,0"
                                Command="{Binding ApplyValveControlCommand}"
                                Content="{app:Lang {x:Static app:LangKey.ApplyText}}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource Button.Link}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,1,1"
                CornerRadius="0,4,4,0">
            <views:CtrFlowLogView Logger="{Binding Controller.Logger, Mode=OneWay}" />
        </Border>
    </Grid>
</wpf:ChromeWindow>
