<wpf:ChromeWindow x:Class="LSIC.App.Views.PopUpgradeView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.FirmwareUpgradeText}}"
                  Width="880"
                  Height="680"
                  d:DataContext="{d:DesignInstance vms:PopUpgradeViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Window.Resources>
        <views:PopUpgradeViewModelProxy x:Key="MainDataContext" Data="{Binding}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0"
                              Margin="10"
                              Content="{app:Lang {x:Static app:LangKey.AllSelectText}}"
                              IsChecked="{Binding IsAllSelected}"
                              IsThreeState="True" />

                    <Rectangle Grid.Row="1"
                               Margin="10,1"
                               Stroke="{DynamicResource BorderBrush}"
                               StrokeDashArray="3 3"
                               StrokeThickness="1" />

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,10,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding UpgradeSelected}" />

                                        <TextBlock Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource FormatTextConverter}">
                                                    <Binding Path="ZoneFormatText" Source="{x:Static app:LangProvider.Instance}" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2"
                                                   Margin="10,0,0,0"
                                                   Foreground="{Binding State, Converter={StaticResource ZoneStateToBrushConverter}}"
                                                   Text="{Binding State, Converter={StaticResource EnumToTextConverter}}" />


                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Session.State, Converter={StaticResource EnumToTextConverter}}" />


                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Session.Progress, StringFormat='{}{0}%'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="10"
                               FontWeight="SemiBold"
                               Text="{app:Lang {x:Static app:LangKey.BoardTypeText}}" />

                    <Rectangle Grid.Row="1"
                               Margin="10,1"
                               Stroke="{DynamicResource BorderBrush}"
                               StrokeDashArray="3 3"
                               StrokeThickness="1" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <wpf:SimplePanel Margin="10,10,10,0">
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource DefaultCornerRadius}">
                                            <Grid Margin="10,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondForegroundBrush}"
                                                               Text="{Binding TypeCode, StringFormat=0x{0:X2}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0"
                                                            HorizontalAlignment="Left"
                                                            Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding File, Converter={StaticResource FilePathToFileNameConverter}, TargetNullValue='--'}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Button Height="Auto"
                                                            Margin="5,0,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            wpf:IconHelper.Geometry="{StaticResource Geometry.CloseSmall}"
                                                            wpf:IconHelper.Height="14"
                                                            wpf:IconHelper.Width="14"
                                                            Command="{Binding Source={StaticResource MainDataContext}, Path=Data.ClearUpgradeFileCommand}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource Button.Icon}" TargetType="{x:Type Button}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding File, Converter={StaticResource StringEmptyToTrueConverter}}" Value="true">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.BrowseCommand}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Button.ChooseFile}" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="Tag_Border"
                                                Width="5"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource SuccessBrush}"
                                                CornerRadius="4,0,0,4" />
                                    </wpf:SimplePanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding File, Converter={StaticResource StringEmptyToTrueConverter}}" Value="true">
                                            <Setter TargetName="Tag_Border" Property="Background" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondForegroundBrush}"
                       Text="{app:Lang {x:Static app:LangKey.FirmwareUpgradePromptText}}" />
            <Button Grid.Column="1"
                    wpf:IconHelper.Geometry="{StaticResource Geometry.Upgrade}"
                    wpf:IconHelper.Height="15"
                    wpf:IconHelper.Width="15"
                    Command="{Binding UpgradeCommand}"
                    Content="{app:Lang {x:Static app:LangKey.UpgradeText}}" />
        </Grid>
    </Grid>
</wpf:ChromeWindow>
