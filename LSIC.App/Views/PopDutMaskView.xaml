<wpf:ChromeWindow x:Class="LSIC.App.Views.PopDutMaskView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.DutMaskText}}"
                  Width="480"
                  Height="520"
                  d:DataContext="{d:DesignInstance vms:PopDutMaskViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpf:MatrixListBox Grid.Row="0"
                           CellHeight="60"
                           CellWidth="60"
                           Cols="{Binding Cols}"
                           HeaderHeight="30"
                           HeaderWidth="30"
                           ItemsSource="{Binding Duts}"
                           Rows="{Binding Rows}"
                           SelectionMode="Multiple">
            <wpf:MatrixListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource MatrixListBoxItem.Default}" TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding Masked, Mode=TwoWay}" />
                </Style>
            </wpf:MatrixListBox.ItemContainerStyle>
            <wpf:MatrixListBox.ItemTemplate>
                <DataTemplate>
                    <wpf:SimplePanel Margin="5"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                        <Path x:Name="IconPath"
                              Data="{StaticResource Geometry.Cpu}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Stretch="Fill" />

                        <TextBlock x:Name="IdText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding ElementName=IconPath, Path=Fill}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Id}" />
                    </wpf:SimplePanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Masked}" Value="True">
                            <Setter TargetName="IconPath" Property="Fill" Value="Gray" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </wpf:MatrixListBox.ItemTemplate>
        </wpf:MatrixListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource Button.Confirm}" />
            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Button.Cancel}" />
        </Grid>
    </Grid>
</wpf:ChromeWindow>