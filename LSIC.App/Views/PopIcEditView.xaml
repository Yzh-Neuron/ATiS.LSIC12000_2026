<wpf:ChromeWindow x:Class="LSIC.App.Views.PopIcEditView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:bhs="clr-namespace:LSIC.App.Behaviors"
                  xmlns:ctrs="clr-namespace:LSIC.App.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="PopTemplateView"
                  Width="1150"
                  Height="850"
                  d:DataContext="{d:DesignInstance vms:PopIcEditViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Window.Resources>
        <views:PopPopIcEditViewModelProxy x:Key="MainDataContext" Data="{Binding}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Text="{app:Lang {x:Static app:LangKey.IcLibraryText}}" />
        </Border>

        <!--  左侧器件集合栏  -->
        <ListBox Grid.Row="2"
                 Grid.Column="0"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Ics}"
                 SelectedItem="{Binding SelectedIc}"
                 Style="{StaticResource ListBox.General}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Width="15"
                              Data="{StaticResource Geometry.Ic}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   Text="{Binding Target.Name}" />
                        <Path Grid.Column="2"
                              Width="15"
                              Data="{StaticResource Geometry.Changed}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform"
                              Visibility="{Binding IsDirty, Converter={StaticResource TrueToVisibilityConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  上方工具栏  -->
        <Border Grid.Row="0"
                Grid.Column="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="5,0,0,0"
                        Command="{Binding CreateIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Content="{app:Lang {x:Static app:LangKey.SaveText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Content="{app:Lang {x:Static app:LangKey.SaveAsText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding DeleteIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Content="{app:Lang {x:Static app:LangKey.ExportText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Content="{app:Lang {x:Static app:LangKey.ImportText}}"
                        Style="{StaticResource Button.Borderless}" />
            </StackPanel>
        </Border>

        <!--  器件编辑区  -->
        <wpf:StateBlock Grid.Row="2"
                        Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        d:IsChecked="true"
                        IsChecked="{Binding SelectedIc, Converter={StaticResource NullObjectToFalseConverter}}">
            <wpf:StateBlock.UnCheckedContent>
                <wpf:UiVoid BorderThickness="1" />
            </wpf:StateBlock.UnCheckedContent>
            <wpf:StateBlock.CheckedContent>
                <TabControl d:DataContext="{d:DesignInstance models:Ic}" DataContext="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedIc.Target}">

                    <!--  基础设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.BaseSettingText}}">
                        <Grid Margin="20" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{app:Lang {x:Static app:LangKey.LogIntervalText}}" />
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,10,0"
                                           Text=":" />
                                <TextBox Grid.Column="2"
                                         Width="100"
                                         Text="{Binding LogInterval.Value}" />

                                <ComboBox Grid.Column="3"
                                          Width="75"
                                          Margin="5,0,0,0"
                                          wpf:LanguageHelper.Auto="True"
                                          DisplayMemberPath="Value"
                                          DockPanel.Dock="Right"
                                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                                          SelectedValue="{Binding LogInterval.Unit}"
                                          SelectedValuePath="Key" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Height="{StaticResource DefaultControlHeight}"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{app:Lang {x:Static app:LangKey.ErrorLogIntervalText}}" />
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,10,0"
                                           Text=":" />
                                <TextBox Grid.Column="2"
                                         Width="100"
                                         Text="{Binding ErrorLogInterval.Value}"
                                         Visibility="{Binding ErrorLogEnable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <ComboBox Grid.Column="3"
                                          Width="75"
                                          Margin="5,0"
                                          DisplayMemberPath="Value"
                                          DockPanel.Dock="Right"
                                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                                          SelectedValue="{Binding ErrorLogInterval.Unit}"
                                          SelectedValuePath="Key"
                                          Visibility="{Binding ErrorLogEnable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <CheckBox Grid.Column="4"
                                          DockPanel.Dock="Right"
                                          IsChecked="{Binding ErrorLogEnable}" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Width="580"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{app:Lang {x:Static app:LangKey.DutConfigFileText}}" />
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,10,0"
                                           Text=":" />
                                <wpf:TextBox Grid.Column="2"
                                             wpf:WidgetHelper.ShowClearButton="True"
                                             Text="{Binding BurnInBoardFile, Mode=TwoWay}" />
                                <Button Grid.Column="3"
                                        Margin="5,0,0,0"
                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectBurnInBoardFileCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Button.ChooseFile}" />
                            </Grid>

                            <Grid Grid.Row="3"
                                  MinWidth="600"
                                  MaxWidth="800"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding BurnInBoardSetting, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" MinHeight="160" />
                                </Grid.RowDefinitions>
                                <wpf:MatrixListBox x:Name="PART_DutSettingsList"
                                                   wpf:BorderHelper.CornerRadius="4,4,0,0"
                                                   BorderThickness="1"
                                                   CellHeight="85"
                                                   CellWidth="85"
                                                   Cols="{Binding BurnInBoardSetting.Column}"
                                                   Grid.IsSharedSizeScope="True"
                                                   HeaderHeight="30"
                                                   HeaderWidth="30"
                                                   ItemsSource="{Binding BurnInBoardSetting.DutSettings}"
                                                   Rows="{Binding BurnInBoardSetting.Row}">
                                    <i:Interaction.Behaviors>
                                        <bhs:DutSelectionBehavior SelectedWrapper="{Binding Source={StaticResource MainDataContext}, Path=Data.DutSettingWrapper, Mode=TwoWay}" />
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <wpf:MatrixListBox.ItemTemplate>
                                        <DataTemplate>
                                            <wpf:SimplePanel Margin="5">
                                                <Path Data="{StaticResource Geometry.SelectCpu}"
                                                      Stretch="Fill"
                                                      Stroke="{DynamicResource ErrorBrush}"
                                                      StrokeThickness="2"
                                                      Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={StaticResource TrueToVisibilityConverter}}" />

                                                <Path Margin="10"
                                                      Data="{StaticResource Geometry.Cpu}"
                                                      Fill="{DynamicResource PrimaryBrush}"
                                                      Stretch="Fill" />

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           IsHitTestVisible="False"
                                                           Text="{Binding Id}" />

                                                <views:ThermostatBadge Margin="0,5,3,0"
                                                                       Temperature="{Binding ThermostatSetting.TargetTemperature}"
                                                                       TemperatureEnabled="{Binding ThermostatSetting.Enable}" />
                                            </wpf:SimplePanel>
                                        </DataTemplate>
                                    </wpf:MatrixListBox.ItemTemplate>
                                </wpf:MatrixListBox>

                                <Border Grid.Row="1"
                                        d:DataContext="{d:DesignInstance models:DutSettingWrapper}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,4,4"
                                        DataContext="{Binding Source={StaticResource MainDataContext}, Path=Data.DutSettingWrapper}">
                                    <Grid Margin="10"
                                          VerticalAlignment="Top"
                                          Visibility="{Binding ., Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition MinHeight="30" />
                                        </Grid.RowDefinitions>
                                        <wpf:SimplePanel Height="30" Visibility="{Binding IsValid, Converter={StaticResource TrueToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{app:Lang {x:Static app:LangKey.ThermostatIndexText}}" />
                                                <TextBlock Margin="3,0,10,0" Text=":" />
                                                <TextBlock Width="100"
                                                           Margin="0,0,5,0"
                                                           Text="{Binding DutSettingTemplate.ThermostatSetting.Id}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock Text="{app:Lang {x:Static app:LangKey.ThermostatEnableText}}" />
                                                <TextBlock Margin="3,0,10,0" Text="(℃):" />
                                                <TextBox Width="100"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding TargetTemperature, Converter={StaticResource IntegerToDecimalConverter10}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding Enable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                                <CheckBox IsChecked="{Binding Enable}" />
                                            </StackPanel>
                                        </wpf:SimplePanel>
                                        <TextBlock Grid.Row="1">
                                            <Run Text="{app:Lang {x:Static app:LangKey.DutText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Id, Mode=OneWay}" />
                                            <Run Text="[" />
                                            <Run Text="{app:Lang {x:Static app:LangKey.RowText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Row, Mode=OneWay}" />
                                            <Run Text="{app:Lang {x:Static app:LangKey.ColumnText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Column, Mode=OneWay}" />
                                            <Run Text="]" />
                                            <Run Text="   " />
                                            <Run Text="{app:Lang {x:Static app:LangKey.BelongChipSelectText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.ChipSelect, Mode=OneWay}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="2">
                                            <Run Text="{app:Lang {x:Static app:LangKey.UsedDpsText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.Dpss, Mode=OneWay, Converter={StaticResource EnumerableToStringConverter}}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="3">
                                            <Run Text="{app:Lang {x:Static app:LangKey.LinkedDrText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.Drs, Mode=OneWay, Converter={StaticResource EnumerableToStringConverter}}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!--  电源设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.DpsSettingText}}">
                        <Grid Margin="10" Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListView Width="140"
                                          wpf:ListViewHelper.CanUserResizeColumns="False"
                                          ItemsSource="{Binding DpsPlans}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectedItem="{Binding Data.SelectedDpsPlan, Source={StaticResource MainDataContext}}">
                                    <i:Interaction.Behaviors>
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn Width="70"
                                                            DisplayMemberBinding="{Binding Name}"
                                                            Header="{app:Lang {x:Static app:LangKey.NameText}}" />
                                            <GridViewColumn Width="70"
                                                            DisplayMemberBinding="{Binding DpssSettings.Count}"
                                                            Header="{app:Lang {x:Static app:LangKey.QuantityText}}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <wpf:SimplePanel Grid.Row="1"
                                                 Margin="0,10,0,0"
                                                 HorizontalAlignment="Stretch">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding Data.CreateDpsPlanCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding Data.DeleteDpsPlanCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                                </wpf:SimplePanel>
                            </Grid>

                            <Grid Grid.Column="2"
                                  d:DataContext="{d:DesignInstance models:DpsPlan}"
                                  DataContext="{Binding Data.SelectedDpsPlan, Source={StaticResource MainDataContext}}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}, Path=.}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid wpf:DataGridDragSort.IsEnabled="True"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding DpssSettings}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="80"
                                                            Binding="{Binding Name}"
                                                            Header="{app:Lang {x:Static app:LangKey.DpsText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Uvp, Converter={StaticResource IntegerToDecimalConverter1000}}"
                                                            Header="{app:Lang {x:Static app:LangKey.VoltageFloorWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Vol, Converter={StaticResource IntegerToDecimalConverter1000}}"
                                                            Header="{app:Lang {x:Static app:LangKey.SetVoltageWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Ovp, Converter={StaticResource IntegerToDecimalConverter1000}}"
                                                            Header="{app:Lang {x:Static app:LangKey.VoltageCeilingWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Ocp, Converter={StaticResource IntegerToDecimalConverter1000}}"
                                                            Header="{app:Lang {x:Static app:LangKey.CurrentCeilingWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Raise, Converter={StaticResource IntegerToIntegerConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.RaiseTimeWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Delay, Converter={StaticResource IntegerToIntegerConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.DelayWithUnitText}}" />

                                        <DataGridTemplateColumn Width="80">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock HorizontalAlignment="Center" Text="{app:Lang {x:Static app:LangKey.EditText}}" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="22"
                                                            Padding="10,0"
                                                            Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditDpsSettingCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Content="{app:Lang {x:Static app:LangKey.EditText}}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource Button.Link}" TargetType="{x:Type Button}">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(Selector.IsSelectionActive)}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="{DynamicResource ContrastForegroundBrush}" />
                                                                    </MultiDataTrigger>

                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(Selector.IsSelectionActive)}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <wpf:SimplePanel Grid.Row="1"
                                                 Margin="0,10,0,0"
                                                 HorizontalAlignment="Stretch">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding Data.CreateDpsSettingCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding Data.DeleteDpsSettingCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                                </wpf:SimplePanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!--  流程设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.ProcessSettingText}}">
                        <TabItem.Resources>
                            <sys:Double x:Key="StepItemHeight">28</sys:Double>
                        </TabItem.Resources>
                        <Grid Margin="10" Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  左侧步骤列表  -->
                            <wpf:ClipBorder Grid.Column="0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Button Margin="5"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding Data.MakeLoopCommand, Source={StaticResource MainDataContext}}"
                                            CommandParameter="{Binding ElementName=StepListBox, Path=SelectedItems}"
                                            Content="将选中步骤设置为循环" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Grid.Resources>
                                                <SolidColorBrush x:Key="LoopLineBrush" Color="#8B98A8" />
                                                <SolidColorBrush x:Key="LoopHoverBrush" Color="#F3F5F8" />
                                                <SolidColorBrush x:Key="LoopPressedBrush" Color="#E3E6EA" />
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  循环槽  -->
                                            <ctrs:LoopSlotControl Grid.Column="0"
                                                                  VerticalAlignment="Top"
                                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                                  BorderThickness="0,1,0,0"
                                                                  ItemsSource="{Binding Process.LoopSlots}"
                                                                  RowCount="{Binding Process.StepItems.Count}"
                                                                  RowHeight="{StaticResource StepItemHeight}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ctrs:LoopSlotPanel RowCount="{Binding RowCount, RelativeSource={RelativeSource AncestorType=ctrs:LoopSlotControl}}" RowHeight="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=ctrs:LoopSlotControl}}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <wpf:SimplePanel HorizontalAlignment="Stretch">
                                                            <!--  循环括号线  -->
                                                            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrs:LoopSlotControl}}, Path=ActualWidth, Converter={StaticResource DivideConverter}, ConverterParameter='2'}"
                                                                  Margin="0,8"
                                                                  HorizontalAlignment="Right">
                                                                <Border BorderBrush="{DynamicResource LoopLineBrush}"
                                                                        BorderThickness="1,1,0,1"
                                                                        CornerRadius="4,0,0,4" />
                                                                <Path Width="8"
                                                                      Height="8"
                                                                      Margin="-2,0,0,-4"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Bottom"
                                                                      Data="M0,0 L0,8 L8,4 Z"
                                                                      Fill="{DynamicResource LoopLineBrush}" />
                                                            </Grid>

                                                            <wpf:SimplePanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <!--  编辑按钮  -->
                                                                <Button wpf:IconHelper.Geometry="{StaticResource Geometry.Loop}"
                                                                        wpf:IconHelper.Height="10"
                                                                        wpf:IconHelper.Width="10"
                                                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditRunStrategyCommand}"
                                                                        CommandParameter="{Binding Loop.RunStrategy}">
                                                                    <Button.Style>
                                                                        <Style BasedOn="{StaticResource Button.Base}" TargetType="{x:Type Button}">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource LoopLineBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource LoopHoverBrush}" />
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource LoopPressedBrush}" />
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <wpf:StateBlock IsChecked="{Binding Loop.RunStrategy.Mode, Converter={StaticResource IncludeValueToTrueConverter}, ConverterParameter='Times'}">
                                                                        <wpf:StateBlock.UnCheckedContent>
                                                                            <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}">
                                                                                <Run Text="{Binding Loop.RunStrategy.Time.Value}" />
                                                                                <Run Text="{Binding Loop.RunStrategy.Time.Unit, Converter={StaticResource EnumToTextConverter}}" />
                                                                            </TextBlock>
                                                                        </wpf:StateBlock.UnCheckedContent>
                                                                        <wpf:StateBlock.CheckedContent>
                                                                            <TextBlock>
                                                                                <Run Text="{Binding Loop.RunStrategy.Count}" />
                                                                                <Run Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
                                                                            </TextBlock>
                                                                        </wpf:StateBlock.CheckedContent>
                                                                    </wpf:StateBlock>
                                                                </Button>

                                                                <!--  解散按钮  -->
                                                                <Button Height="Auto"
                                                                        Margin="0,-5,-7,0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        wpf:IconHelper.Geometry="{StaticResource Geometry.CloseSmall}"
                                                                        wpf:IconHelper.Height="14"
                                                                        wpf:IconHelper.Width="14"
                                                                        Background="{DynamicResource SecondBackgroundBrush}"
                                                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.RemoveLoopCommand}"
                                                                        CommandParameter="{Binding Loop}"
                                                                        Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style BasedOn="{StaticResource Button.Icon}" TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=wpf:SimplePanel}, Path=IsMouseOver}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </wpf:SimplePanel>
                                                        </wpf:SimplePanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ctrs:LoopSlotControl>
                                            <!--  步骤  -->
                                            <ListBox x:Name="StepListBox"
                                                     Grid.Column="1"
                                                     wpf:BorderHelper.CornerRadius="0"
                                                     wpf:ListBoxDragSort.CanDragCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.CanDragStepCommand}"
                                                     wpf:ListBoxDragSort.CanDropCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.CanDropStepCommand}"
                                                     wpf:ListBoxDragSort.DropCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.DropStepCommand}"
                                                     wpf:ListBoxDragSort.IsEnabled="True"
                                                     wpf:MouseWheelBubble.IsEnabled="True"
                                                     Background="Transparent"
                                                     BorderThickness="1,1,0,0"
                                                     ItemsSource="{Binding Process.StepItems}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     SelectedItem="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedStepItem}"
                                                     SelectionMode="Extended">

                                                <ListBox.Resources>
                                                    <!--  向量  -->
                                                    <DataTemplate DataType="{x:Type models:StepVector}">
                                                        <Border Height="{StaticResource StepItemHeight}">
                                                            <Grid Margin="10,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="0"
                                                                      Width="18"
                                                                      Height="11"
                                                                      Data="{StaticResource Geometry.StepVector}"
                                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                                                      SnapsToDevicePixels="True"
                                                                      Stretch="Uniform" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="10,0"
                                                                           Text="{Binding Name}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>

                                                    <!--  电源步  -->
                                                    <DataTemplate DataType="{x:Type models:StepPower}">
                                                        <Grid x:Name="mainContainer" Margin="10,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path x:Name="IconPath"
                                                                  Grid.Column="0"
                                                                  Width="18"
                                                                  Height="11"
                                                                  Data="{StaticResource Geometry.StepPower}"
                                                                  Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                                                  SnapsToDevicePixels="True"
                                                                  Stretch="Uniform" />
                                                            <TextBlock x:Name="NameText"
                                                                       Grid.Column="1"
                                                                       Margin="10,0"
                                                                       Text="{Binding Name}" />
                                                        </Grid>

                                                    </DataTemplate>
                                                </ListBox.Resources>

                                                <ListBox.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource ListBoxItem.General}" TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="wpf:BorderHelper.CornerRadius" Value="0" />
                                                        <Setter Property="Height" Value="{StaticResource StepItemHeight}" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Background" Value="{DynamicResource SecondBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInLoop}" Value="true">
                                                                <Setter Property="Background" Value="{StaticResource LoopHoverBrush}" />

                                                            </DataTrigger>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource ContrastForegroundBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>

                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </wpf:ClipBorder>
                            <wpf:SimplePanel Grid.Row="1"
                                             Grid.Column="0"
                                             Margin="0,10,0,0"
                                             HorizontalAlignment="Stretch">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding Data.CreateStepItemCommand, Source={StaticResource MainDataContext}}"
                                        CommandParameter="{Binding ElementName=StepListBox, Path=SelectedItems}"
                                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding Data.DeleteStepItemCommand, Source={StaticResource MainDataContext}}"
                                        CommandParameter="{Binding ElementName=StepListBox, Path=SelectedItems}"
                                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                            </wpf:SimplePanel>

                            <!--  右侧步骤详情  -->
                            <Grid Grid.Column="2"
                                  d:DataContext="{d:DesignInstance models:StepItem}"
                                  DataContext="{Binding Data.SelectedStepItem, Source={StaticResource MainDataContext}}"
                                  Visibility="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedStepItem, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  公共信息  -->
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid Margin="20" Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{app:Lang {x:Static app:LangKey.CurrentStepText}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="3,0,10,0"
                                                       Text=":" />
                                            <TextBlock Grid.Column="3"
                                                       Width="80"
                                                       Text="{Binding Name}" />
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Margin="0,20,0,0"
                                              HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{app:Lang {x:Static app:LangKey.DpsPlanText}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="3,0,10,0"
                                                       Text=":" />
                                            <ComboBox Grid.Column="2"
                                                      Width="100"
                                                      DisplayMemberPath="Name"
                                                      ItemsSource="{Binding Data.SelectedIc.Target.DpsPlans, Source={StaticResource MainDataContext}}"
                                                      SelectedValue="{Binding DpsPlan}"
                                                      SelectedValuePath="Name" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!--  具体信息  -->
                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <ContentControl Margin="20"
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding .}">
                                        <ContentControl.Resources>
                                            <!--  电源步显示  -->
                                            <DataTemplate DataType="{x:Type models:StepPower}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{app:Lang {x:Static app:LangKey.PatternTimeoutText}}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="3,0,10,0"
                                                               Text=":" />
                                                    <TextBox Grid.Column="2"
                                                             Width="100"
                                                             Text="{Binding Timeout}" />

                                                    <TextBlock Grid.Column="3"
                                                               Margin="5,0,0,0"
                                                               Text="{app:Lang {x:Static app:LangKey.Enum_TimeUnit_Second}}" />
                                                </Grid>
                                            </DataTemplate>

                                            <!--  向量步显示  -->
                                            <DataTemplate DataType="{x:Type models:StepVector}">
                                                <Grid Height="{StaticResource DefaultControlHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{app:Lang {x:Static app:LangKey.RunStrategyText}}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="3,0,10,0"
                                                               Text=":" />
                                                    <wpf:StateBlock Grid.Column="2" IsChecked="{Binding RunStrategy.Mode, Converter={StaticResource IncludeValueToTrueConverter}, ConverterParameter='Times'}">
                                                        <wpf:StateBlock.UnCheckedContent>
                                                            <TextBlock Foreground="Black">
                                                                <Run Text="{Binding RunStrategy.Time.Value}" />
                                                                <Run Text="{Binding RunStrategy.Time.Unit, Converter={StaticResource EnumToTextConverter}}" />
                                                            </TextBlock>
                                                        </wpf:StateBlock.UnCheckedContent>
                                                        <wpf:StateBlock.CheckedContent>
                                                            <TextBlock Foreground="Black">
                                                                <Run Text="{Binding RunStrategy.Count}" />
                                                                <Run Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
                                                            </TextBlock>
                                                        </wpf:StateBlock.CheckedContent>
                                                    </wpf:StateBlock>

                                                    <Button Grid.Column="3"
                                                            Margin="10,0,0,0"
                                                            Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditRunStrategyCommand}"
                                                            CommandParameter="{Binding RunStrategy}"
                                                            Content="{app:Lang {x:Static app:LangKey.EditText}}"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            Style="{StaticResource Button.Link}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ContentControl.Resources>
                                    </ContentControl>
                                </Border>

                                <!--  向量  -->
                                <DataGrid Grid.Row="2"
                                          Margin="0,10,0,0"
                                          wpf:DataGridDragSort.IsEnabled="True"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Vectors}"
                                          SelectedItem="{Binding Data.SelectedVector, Source={StaticResource MainDataContext}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding PatternFile, Converter={StaticResource FilePathToFileNameConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.PatternFileText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding RegisterFile, Converter={StaticResource FilePathToFileNameConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.RegisterFileText}}" />

                                        <DataGridTemplateColumn Width="80">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock HorizontalAlignment="Center" Text="{app:Lang {x:Static app:LangKey.EditText}}" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="22"
                                                            Padding="10,0"
                                                            Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditVectorCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Content="{app:Lang {x:Static app:LangKey.EditText}}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource Button.Link}" TargetType="{x:Type Button}">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(Selector.IsSelectionActive)}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="{DynamicResource ContrastForegroundBrush}" />
                                                                    </MultiDataTrigger>

                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(Selector.IsSelectionActive)}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <wpf:SimplePanel Grid.Row="1"
                                             Grid.Column="2"
                                             Margin="0,10,0,0"
                                             HorizontalAlignment="Stretch">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding Data.CreateVectorCommand, Source={StaticResource MainDataContext}}"
                                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding Data.DeleteVectorCommand, Source={StaticResource MainDataContext}}"
                                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                            </wpf:SimplePanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </wpf:StateBlock.CheckedContent>
        </wpf:StateBlock>
    </Grid>
</wpf:ChromeWindow>
