<wpf:ChromeWindow x:Class="LSIC.App.Views.PopIcEditView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:attachs="clr-namespace:LSIC.App.Attachs"
                  xmlns:bhs="clr-namespace:LSIC.App.Behaviors"
                  xmlns:ctrs="clr-namespace:LSIC.App.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.IcEditText}}"
                  Width="1150"
                  Height="950"
                  MinWidth="1150"
                  MinHeight="900"
                  d:DataContext="{d:DesignInstance vms:PopIcEditViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Window.Resources>
        <views:PopPopIcEditViewModelProxy x:Key="MainDataContext" Data="{Binding}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Text="{app:Lang {x:Static app:LangKey.IcLibraryText}}" />
        </Border>

        <!--  左侧器件集合栏  -->
        <ListBox Grid.Row="2"
                 Grid.Column="0"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Ics}"
                 SelectedItem="{Binding SelectedIc}"
                 Style="{StaticResource ListBox.General}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Width="15"
                              Data="{StaticResource Geometry.Ic}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   Text="{Binding Name}" />
                        <Path x:Name="IsDirtyPath"
                              Grid.Column="2"
                              Width="15"
                              Data="{StaticResource Geometry.Changed}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                              SnapsToDevicePixels="True"
                              Stretch="Uniform"
                              Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Ic.IsDirty}" Value="true">
                            <Setter TargetName="IsDirtyPath" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  上方工具栏  -->
        <Border Grid.Row="0"
                Grid.Column="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="5,0,0,0"
                        Command="{Binding CreateIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding SaveIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.SaveText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding DeleteIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding SaveAsIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.SaveAsText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding ExportIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.ExportText}}"
                        Style="{StaticResource Button.Borderless}" />
                <Button Margin="5,0,0,0"
                        Command="{Binding ImportIcCommand}"
                        Content="{app:Lang {x:Static app:LangKey.ImportText}}"
                        Style="{StaticResource Button.Borderless}" />
            </StackPanel>
        </Border>

        <!--  器件编辑区  -->
        <wpf:StateBlock Grid.Row="2"
                        Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        d:IsChecked="true"
                        IsChecked="{Binding SelectedIc, Converter={StaticResource NullObjectToFalseConverter}}">
            <wpf:StateBlock.UnCheckedContent>
                <wpf:UiVoid BorderThickness="1" />
            </wpf:StateBlock.UnCheckedContent>
            <wpf:StateBlock.CheckedContent>
                <TabControl d:DataContext="{d:DesignInstance models:Ic}"
                            wpf:TabControlHelper.HeaderWidth="120"
                            DataContext="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedIc.Target}">

                    <!--  基础设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.BaseSettingText}}">
                        <Grid Margin="20" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                    <Run Text="{app:Lang {x:Static app:LangKey.LogIntervalText}}" />
                                    <Run Text=":" />
                                </TextBlock>

                                <TextBox Grid.Column="1"
                                         Width="100"
                                         Text="{Binding LogInterval.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}" />

                                <ComboBox Grid.Column="2"
                                          Width="85"
                                          Margin="5,0,0,0"
                                          DisplayMemberPath="Value"
                                          DockPanel.Dock="Right"
                                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                                          SelectedValue="{Binding LogInterval.Unit}"
                                          SelectedValuePath="Key" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Height="{StaticResource DefaultControlHeight}"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                    <Run Text="{app:Lang {x:Static app:LangKey.ErrorLogIntervalText}}" />
                                    <Run Text=":" />
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         Width="100"
                                         Text="{Binding ErrorLogInterval.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntegerToIntegerConverter}}"
                                         Visibility="{Binding ErrorLogEnable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <ComboBox Grid.Column="2"
                                          Width="85"
                                          Margin="5,0"
                                          DisplayMemberPath="Value"
                                          DockPanel.Dock="Right"
                                          ItemsSource="{Binding Source={x:Type app:TimeUnit}, Converter={StaticResource EnumToTextPairsConverter}}"
                                          SelectedValue="{Binding ErrorLogInterval.Unit}"
                                          SelectedValuePath="Key"
                                          Visibility="{Binding ErrorLogEnable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <CheckBox Grid.Column="3"
                                          DockPanel.Dock="Right"
                                          IsChecked="{Binding ErrorLogEnable}" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Height="{StaticResource DefaultControlHeight}"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                    <Run Text="{app:Lang {x:Static app:LangKey.ForceStepLoadText}}" />
                                    <Run Text=":" />
                                </TextBlock>
                                <CheckBox Grid.Column="3"
                                          DockPanel.Dock="Right"
                                          IsChecked="{Binding ForceStepLoad}" />
                            </Grid>

                            <Grid Grid.Row="3"
                                  Width="580"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                    <Run Text="{app:Lang {x:Static app:LangKey.DutConfigFileText}}" />
                                    <Run Text=":" />
                                </TextBlock>
                                <wpf:TextBox Grid.Column="1"
                                             wpf:WidgetHelper.ShowClearButton="True"
                                             IsReadOnly="True"
                                             Text="{Binding BurnInBoardFile, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        Margin="5,0,0,0"
                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectBurnInBoardFileCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Button.ChooseFile}" />
                            </Grid>

                            <Grid Grid.Row="4"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding BurnInBoardSetting, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" MinHeight="140" />
                                </Grid.RowDefinitions>
                                <wpf:MatrixListBox x:Name="PART_DutSettingsList"
                                                   wpf:BorderHelper.CornerRadius="4,4,0,0"
                                                   BorderThickness="1"
                                                   CellHeight="85"
                                                   CellWidth="85"
                                                   Cols="{Binding BurnInBoardSetting.Column}"
                                                   HeaderHeight="30"
                                                   HeaderWidth="30"
                                                   ItemsSource="{Binding BurnInBoardSetting.DutSettings}"
                                                   Rows="{Binding BurnInBoardSetting.Row}">
                                    <i:Interaction.Behaviors>
                                        <bhs:DutSelectionBehavior SelectedWrapper="{Binding Source={StaticResource MainDataContext}, Path=Data.DutSettingWrapper, Mode=TwoWay}" />
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <wpf:MatrixListBox.ItemTemplate>
                                        <DataTemplate>
                                            <wpf:SimplePanel Margin="5">
                                                <Path Data="{StaticResource Geometry.SelectCpu}"
                                                      Stretch="Fill"
                                                      Stroke="{DynamicResource ErrorBrush}"
                                                      StrokeThickness="2"
                                                      Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={StaticResource TrueToVisibilityConverter}}" />

                                                <Path Margin="10"
                                                      Data="{StaticResource Geometry.Cpu}"
                                                      Fill="{DynamicResource PrimaryBrush}"
                                                      Stretch="Fill" />

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           IsHitTestVisible="False"
                                                           Text="{Binding Id}" />

                                                <views:ThermostatBadge Margin="0,5,3,0"
                                                                       Temperature="{Binding ThermostatSetting.TargetTemperature, Mode=OneWay}"
                                                                       TemperatureEnabled="{Binding ThermostatSetting.Enable, Mode=OneWay}" />
                                            </wpf:SimplePanel>
                                        </DataTemplate>
                                    </wpf:MatrixListBox.ItemTemplate>
                                </wpf:MatrixListBox>

                                <Border Grid.Row="1"
                                        d:DataContext="{d:DesignInstance models:DutSettingWrapper}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,4,4"
                                        DataContext="{Binding Source={StaticResource MainDataContext}, Path=Data.DutSettingWrapper}"
                                        Validation.ErrorTemplate="{x:Null}">
                                    <Grid Margin="10"
                                          VerticalAlignment="Top"
                                          Validation.ErrorTemplate="{x:Null}"
                                          Visibility="{Binding ., Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition MinHeight="30" />
                                        </Grid.RowDefinitions>
                                        <wpf:SimplePanel Height="30" Visibility="{Binding IsValid, Converter={StaticResource TrueToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,10,0">
                                                    <Run Text="{app:Lang {x:Static app:LangKey.ThermostatIndexText}}" />
                                                    <Run Text=":" />
                                                </TextBlock>

                                                <TextBlock Width="100"
                                                           Margin="0,0,5,0"
                                                           Text="{Binding DutSettingTemplate.ThermostatSetting.Id}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,10,0">
                                                    <Run Text="{app:Lang {x:Static app:LangKey.ThermostatEnableText}}" />
                                                    <Run Text="(℃):" />
                                                </TextBlock>
                                                <TextBox Width="100"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding TargetTemperature, Converter={StaticResource IntegerToDecimalConverter10}, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding Enable, Converter={StaticResource TrueToVisibilityConverter}}" />
                                                <CheckBox IsChecked="{Binding Enable}" />
                                            </StackPanel>
                                        </wpf:SimplePanel>
                                        <TextBlock Grid.Row="1">
                                            <Run Text="{app:Lang {x:Static app:LangKey.DutText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Id, Mode=OneWay}" />
                                            <Run Text="[" />
                                            <Run Text="{app:Lang {x:Static app:LangKey.RowText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Row, Mode=OneWay}" />
                                            <Run Text="{app:Lang {x:Static app:LangKey.ColumnText}}" />
                                            <Run Text="{Binding DutSettingTemplate.Column, Mode=OneWay}" />
                                            <Run Text="]" />
                                            <Run Text="   " />
                                            <Run Text="{app:Lang {x:Static app:LangKey.BelongChipSelectText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.ChipSelect, Mode=OneWay}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="2">
                                            <Run Text="{app:Lang {x:Static app:LangKey.UsedDpsText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.Dpss, Mode=OneWay, Converter={StaticResource EnumerableToStringConverter}}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="3" MaxWidth="700">
                                            <Run Text="{app:Lang {x:Static app:LangKey.LinkedDrText}}" />
                                            <Run Text="[" />
                                            <Run Text="{Binding DutSettingTemplate.Drs, Mode=OneWay, Converter={StaticResource EnumerableToStringConverter}}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!--  电源设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.DpsSettingText}}">
                        <Grid Margin="10,20,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListView Width="150"
                                          wpf:ListViewHelper.CanUserResizeColumns="False"
                                          ItemsSource="{Binding DpsPlans}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectedItem="{Binding Data.SelectedDpsPlan, Source={StaticResource MainDataContext}}">
                                    <i:Interaction.Behaviors>
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding Data.ImportDpsPlanCommand, Source={StaticResource MainDataContext}}" Header="{app:Lang {x:Static app:LangKey.ImportDpsPlanText}}" />
                                            <MenuItem Command="{Binding Data.ExportDpsPlanCommand, Source={StaticResource MainDataContext}}" Header="{app:Lang {x:Static app:LangKey.ExportDpsPlanText}}" />
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn Width="80"
                                                            DisplayMemberBinding="{Binding Name}"
                                                            Header="{app:Lang {x:Static app:LangKey.DpsPlanText}}" />
                                            <GridViewColumn Width="70"
                                                            DisplayMemberBinding="{Binding DpssSettings.Count}"
                                                            Header="{app:Lang {x:Static app:LangKey.QuantityText}}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <wpf:SimplePanel Grid.Row="1"
                                                 Margin="0,10,0,0"
                                                 HorizontalAlignment="Stretch">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding Data.CreateDpsPlanCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding Data.DeleteDpsPlanCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                                </wpf:SimplePanel>
                            </Grid>

                            <Grid Grid.Column="2"
                                  d:DataContext="{d:DesignInstance models:DpsPlan}"
                                  DataContext="{Binding Data.SelectedDpsPlan, Source={StaticResource MainDataContext}}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}, Path=.}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid wpf:DataGridDoubleClick.Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditDpsSettingCommand}"
                                          wpf:DataGridDragSort.IsEnabled="True"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding DpssSettings}"
                                          SelectedItem="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedDpsSetting}">
                                    <i:Interaction.Behaviors>
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="80"
                                                            Binding="{Binding Name}"
                                                            Header="{app:Lang {x:Static app:LangKey.DpsText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Vol, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}"
                                                            Header="{app:Lang {x:Static app:LangKey.SetVoltageWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Ovp, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}"
                                                            Header="{app:Lang {x:Static app:LangKey.VoltageCeilingWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Uvp, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}"
                                                            Header="{app:Lang {x:Static app:LangKey.VoltageFloorWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Ocp, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}"
                                                            Header="{app:Lang {x:Static app:LangKey.CurrentCeilingWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Raise, Converter={StaticResource IntegerToIntegerConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.RaiseTimeWithUnitText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding Delay, Converter={StaticResource IntegerToIntegerConverter}}"
                                                            Header="{app:Lang {x:Static app:LangKey.DelayWithUnitText}}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <wpf:SimplePanel Grid.Row="1"
                                                 Margin="0,10,0,0"
                                                 HorizontalAlignment="Stretch">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding Data.CreateDpsSettingCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding Data.DeleteDpsSettingCommand, Source={StaticResource MainDataContext}}"
                                            Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                                </wpf:SimplePanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!--  流程设置  -->
                    <TabItem Header="{app:Lang {x:Static app:LangKey.ProcessSettingText}}">
                        <TabItem.Resources>
                            <sys:Double x:Key="StepItemHeight">28</sys:Double>
                        </TabItem.Resources>
                        <Grid Margin="10,20,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  左侧步骤列表  -->
                            <wpf:ClipBorder Grid.Column="0"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}"
                                            DataContext="{Binding Process}">
                                <wpf:ClipBorder.Style>
                                    <Style TargetType="{x:Type wpf:ClipBorder}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="Validation.HasError" Value="true">
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                                <Setter Property="ToolTip">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource ValidationErrorsToStringConverter}">
                                                            <Binding Path="(Validation.Errors)" RelativeSource="{RelativeSource Self}" />
                                                            <Binding FallbackValue="{x:Null}"
                                                                     Path="(Validation.Errors)/"
                                                                     RelativeSource="{RelativeSource Self}" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </wpf:ClipBorder.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Button Margin="5"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding Data.MakeLoopCommand, Source={StaticResource MainDataContext}}"
                                            CommandParameter="{Binding SelectedItems, Source={x:Reference StepListBox}}"
                                            Content="{app:Lang {x:Static app:LangKey.SetStepsAsLoopText}}" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="11*" />
                                                <ColumnDefinition Width="20*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  循环槽  -->
                                            <ctrs:LoopSlotControl Grid.Column="0"
                                                                  VerticalAlignment="Top"
                                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                                  BorderThickness="0,1,0,0"
                                                                  ItemsSource="{Binding LoopSlots}"
                                                                  RowCount="{Binding StepItems.Count}"
                                                                  RowHeight="{StaticResource StepItemHeight}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ctrs:LoopSlotPanel RowCount="{Binding RowCount, RelativeSource={RelativeSource AncestorType=ctrs:LoopSlotControl}}" RowHeight="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=ctrs:LoopSlotControl}}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <wpf:SimplePanel HorizontalAlignment="Stretch">
                                                            <!--  循环括号线  -->
                                                            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrs:LoopSlotControl}}, Path=ActualWidth, Converter={StaticResource DivideConverter}, ConverterParameter='2'}"
                                                                  Margin="0,8"
                                                                  HorizontalAlignment="Right">
                                                                <Border BorderBrush="{DynamicResource LoopLineBrush}"
                                                                        BorderThickness="1,1,0,1"
                                                                        CornerRadius="4,0,0,4" />
                                                                <Path Width="8"
                                                                      Height="8"
                                                                      Margin="-2,0,0,-4"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Bottom"
                                                                      Data="M0,0 L0,8 L8,4 Z"
                                                                      Fill="{DynamicResource LoopLineBrush}" />
                                                            </Grid>

                                                            <wpf:SimplePanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <!--  编辑循环策略按钮  -->
                                                                <Button wpf:IconHelper.Geometry="{StaticResource Geometry.Loop}"
                                                                        wpf:IconHelper.Height="10"
                                                                        wpf:IconHelper.Width="10"
                                                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditLoopStrategyCommand}"
                                                                        CommandParameter="{Binding Loop.ExecuteStrategy}">
                                                                    <Button.Style>
                                                                        <Style BasedOn="{StaticResource Button.Base}" TargetType="{x:Type Button}">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource LoopLineBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource LoopHoverBrush}" />
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource LoopPressedBrush}" />
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <wpf:StateBlock DataContext="{Binding Loop.ExecuteStrategy}" IsChecked="{Binding Mode, Converter={StaticResource IncludeValueToTrueConverter}, ConverterParameter='Times'}">
                                                                        <wpf:StateBlock.UnCheckedContent>
                                                                            <TextBlock Style="{StaticResource TextBlock.Error}" Tag="{Binding Time}">
                                                                                <Run Text="{Binding Time.Value}" />
                                                                                <Run Text="{Binding Time.Unit, Converter={StaticResource EnumToTextConverter}}" />
                                                                            </TextBlock>
                                                                        </wpf:StateBlock.UnCheckedContent>
                                                                        <wpf:StateBlock.CheckedContent>
                                                                            <TextBlock>
                                                                                <Run Text="{Binding Count}" />
                                                                                <Run Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
                                                                            </TextBlock>
                                                                        </wpf:StateBlock.CheckedContent>
                                                                    </wpf:StateBlock>
                                                                </Button>

                                                                <!--  解散按钮  -->
                                                                <Button Height="Auto"
                                                                        Margin="0,-5,-7,0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        wpf:IconHelper.Geometry="{StaticResource Geometry.CloseSmall}"
                                                                        wpf:IconHelper.Height="14"
                                                                        wpf:IconHelper.Width="14"
                                                                        Background="{DynamicResource SecondBackgroundBrush}"
                                                                        Command="{Binding Source={StaticResource MainDataContext}, Path=Data.RemoveLoopCommand}"
                                                                        CommandParameter="{Binding Loop}"
                                                                        Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style BasedOn="{StaticResource Button.Icon}" TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=wpf:SimplePanel}, Path=IsMouseOver}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </wpf:SimplePanel>
                                                        </wpf:SimplePanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ctrs:LoopSlotControl>
                                            <!--  步骤  -->
                                            <ListBox x:Name="StepListBox"
                                                     Grid.Column="1"
                                                     wpf:BorderHelper.CornerRadius="0"
                                                     wpf:ListBoxDragSort.CanDragCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.CanDragStepCommand}"
                                                     wpf:ListBoxDragSort.CanDropCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.CanDropStepCommand}"
                                                     wpf:ListBoxDragSort.DropCommand="{Binding Source={StaticResource MainDataContext}, Path=Data.DropStepCommand}"
                                                     wpf:ListBoxDragSort.IsEnabled="True"
                                                     wpf:MouseWheelBubble.IsEnabled="True"
                                                     Background="Transparent"
                                                     BorderThickness="1,1,0,0"
                                                     ItemsSource="{Binding StepItems}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     SelectedItem="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedStepItem}"
                                                     SelectionMode="Extended"
                                                     Validation.ErrorTemplate="{x:Null}">
                                                <i:Interaction.Behaviors>
                                                    <wpf:AutoSelectFirstBehavior />
                                                </i:Interaction.Behaviors>
                                                <ListBox.Resources>
                                                    <DataTemplate DataType="{x:Type models:StepItem}">
                                                        <Border Height="{StaticResource StepItemHeight}">
                                                            <Grid Margin="10,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path x:Name="IconPath"
                                                                      Grid.Column="0"
                                                                      Width="16"
                                                                      Height="12"
                                                                      Data="{StaticResource Geometry.StepPower}"
                                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                                                      SnapsToDevicePixels="True"
                                                                      Stretch="Uniform"
                                                                      Validation.ErrorTemplate="{x:Null}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="10,0"
                                                                           Text="{Binding Name}" />
                                                                <Path x:Name="errorPath"
                                                                      Grid.Column="2"
                                                                      Width="17"
                                                                      Height="12"
                                                                      attachs:ValidationWatcher.Source="{Binding .}"
                                                                      Data="{StaticResource Geometry.ErrorTip}"
                                                                      Fill="{DynamicResource ErrorBrush}"
                                                                      SnapsToDevicePixels="True"
                                                                      Stretch="Uniform"
                                                                      ToolTip="{Binding Path=(attachs:ValidationWatcher.Errors), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                      ToolTipService.InitialShowDelay="0"
                                                                      Validation.ErrorTemplate="{x:Null}"
                                                                      Visibility="Collapsed">
                                                                    <Path.Resources>
                                                                        <Style BasedOn="{StaticResource ToolTip.ErrorBubble}" TargetType="{x:Type ToolTip}" />
                                                                    </Path.Resources>
                                                                </Path>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Vector">
                                                                <Setter TargetName="IconPath" Property="Data" Value="{StaticResource Geometry.StepVector}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Path=(attachs:ValidationWatcher.HasErrors), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                <Setter TargetName="errorPath" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.Resources>
                                                <ListBox.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource ListBoxItem.General}" TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="wpf:BorderHelper.CornerRadius" Value="0" />
                                                        <Setter Property="Height" Value="{StaticResource StepItemHeight}" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Background" Value="{DynamicResource SecondBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="attachs:ValidationWatcher.Source" Value="{Binding .}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInLoop}" Value="true">
                                                                <Setter Property="Background" Value="{DynamicResource LoopHoverBrush}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource ContrastForegroundBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </wpf:ClipBorder>
                            <wpf:SimplePanel Grid.Row="1"
                                             Grid.Column="0"
                                             Margin="0,10,0,0"
                                             HorizontalAlignment="Stretch">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding Data.CreateStepItemCommand, Source={StaticResource MainDataContext}}"
                                        CommandParameter="{Binding SelectedItems, Source={x:Reference StepListBox}}"
                                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding Data.DeleteStepItemCommand, Source={StaticResource MainDataContext}}"
                                        CommandParameter="{Binding SelectedItems, Source={x:Reference StepListBox}}"
                                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                            </wpf:SimplePanel>

                            <!--  右侧步骤详情  -->
                            <Grid Grid.Column="2"
                                  d:DataContext="{d:DesignInstance models:StepItem}"
                                  DataContext="{Binding Data.SelectedStepItem, Source={StaticResource MainDataContext}}"
                                  Validation.ErrorTemplate="{x:Null}"
                                  Visibility="{Binding Source={StaticResource MainDataContext}, Path=Data.SelectedStepItem, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  步骤详情  -->
                                <wpf:SimplePanel>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}" />
                                    <TextBlock Height="24"
                                               Margin="20,-9,0,0"
                                               Padding="5,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Background="{DynamicResource SecondBackgroundBrush}"
                                               Text="{app:Lang {x:Static app:LangKey.BaseInfoText}}" />
                                    <Grid Margin="20,25,20,20" Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                                <Run Text="{app:Lang {x:Static app:LangKey.CurrentStepText}}" />
                                                <Run Text=":" />
                                            </TextBlock>

                                            <TextBlock Grid.Column="3"
                                                       Width="80"
                                                       Text="{Binding Name}" />
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Margin="0,20,0,0"
                                              HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                                <Run Text="{app:Lang {x:Static app:LangKey.DpsPlanText}}" />
                                                <Run Text=":" />
                                            </TextBlock>
                                            <ComboBox Grid.Column="2"
                                                      Width="100"
                                                      DisplayMemberPath="Name"
                                                      SelectedValue="{Binding DpsPlan}"
                                                      SelectedValuePath="Name">
                                                <ComboBox.ItemsSource>
                                                    <CompositeCollection>
                                                        <x:Static Member="models:DpsPlan.None" />
                                                        <CollectionContainer Collection="{Binding Data.SelectedIc.Target.DpsPlans, Source={StaticResource MainDataContext}}" />
                                                    </CompositeCollection>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                        </Grid>

                                        <ContentControl Grid.Row="2"
                                                        Margin="0,20,0,0"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding .}"
                                                        Validation.ErrorTemplate="{x:Null}">
                                            <ContentControl.Visibility>
                                                <MultiBinding Converter="{StaticResource StepPowerHasDpsPlanToVisibilityConverter}">
                                                    <Binding Path="." UpdateSourceTrigger="PropertyChanged" />
                                                    <Binding Path="DpsPlan" UpdateSourceTrigger="PropertyChanged" />
                                                </MultiBinding>
                                            </ContentControl.Visibility>
                                            <ContentControl.Resources>
                                                <!--  电源步显示  -->
                                                <DataTemplate DataType="{x:Type models:StepPower}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                                            <Run Text="{app:Lang {x:Static app:LangKey.PatternTimeoutText}}" />
                                                            <Run Text=":" />
                                                        </TextBlock>
                                                        <TextBox Grid.Column="1"
                                                                 Width="100"
                                                                 Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="5,0,0,0"
                                                                   Text="{app:Lang {x:Static app:LangKey.Enum_TimeUnit_Second}}" />
                                                    </Grid>
                                                </DataTemplate>

                                                <!--  向量步显示  -->
                                                <DataTemplate DataType="{x:Type models:StepVector}">
                                                    <Grid Height="{StaticResource DefaultControlHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                                                            <Run Text="{app:Lang {x:Static app:LangKey.RunStrategyText}}" />
                                                            <Run Text=":" />
                                                        </TextBlock>

                                                        <wpf:StateBlock Grid.Column="1"
                                                                        DataContext="{Binding ExecuteStrategy}"
                                                                        IsChecked="{Binding Mode, Converter={StaticResource IncludeValueToTrueConverter}, ConverterParameter='Times'}">
                                                            <wpf:StateBlock.UnCheckedContent>
                                                                <TextBlock Style="{StaticResource TextBlock.Error}" Tag="{Binding Time}">
                                                                    <Run Text="{Binding Time.Value}" />
                                                                    <Run Text="{Binding Time.Unit, Converter={StaticResource EnumToTextConverter}}" />
                                                                </TextBlock>
                                                            </wpf:StateBlock.UnCheckedContent>
                                                            <wpf:StateBlock.CheckedContent>
                                                                <TextBlock>
                                                                    <Run Text="{Binding Count}" />
                                                                    <Run Text="{app:Lang {x:Static app:LangKey.TimesText}}" />
                                                                </TextBlock>
                                                            </wpf:StateBlock.CheckedContent>
                                                        </wpf:StateBlock>

                                                        <Button Grid.Column="2"
                                                                Margin="10,0,0,0"
                                                                Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditRunStrategyCommand}"
                                                                CommandParameter="{Binding ExecuteStrategy}"
                                                                Content="{app:Lang {x:Static app:LangKey.EditText}}"
                                                                Foreground="{DynamicResource PrimaryBrush}"
                                                                Style="{StaticResource Button.Link}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </Grid>
                                </wpf:SimplePanel>

                                <!--  向量集合  -->
                                <DataGrid Grid.Row="1"
                                          Margin="0,10,0,0"
                                          wpf:DataGridDoubleClick.Command="{Binding Source={StaticResource MainDataContext}, Path=Data.EditVectorCommand}"
                                          wpf:DataGridDragSort.IsEnabled="True"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Vectors}"
                                          SelectedItem="{Binding Data.SelectedVector, Source={StaticResource MainDataContext}}">
                                    <DataGrid.Visibility>
                                        <MultiBinding Converter="{StaticResource StepPowerHasDpsPlanToVisibilityConverter}">
                                            <Binding Path="." UpdateSourceTrigger="PropertyChanged" />
                                            <Binding Path="DpsPlan" UpdateSourceTrigger="PropertyChanged" />
                                        </MultiBinding>
                                    </DataGrid.Visibility>
                                    <i:Interaction.Behaviors>
                                        <wpf:AutoSelectFirstBehavior />
                                    </i:Interaction.Behaviors>
                                    <DataGrid.Style>
                                        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="{x:Type DataGrid}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasErrors}" Value="true">
                                                    <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource ValidationErrorsToStringConverter}">
                                                                <Binding Path="(Validation.Errors)" RelativeSource="{RelativeSource Self}" />
                                                                <Binding FallbackValue="{x:Null}"
                                                                         Path="(Validation.Errors)/"
                                                                         RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding PatternFile, Converter={StaticResource FilePathToFileNameConverter}, TargetNullValue='--'}"
                                                            ElementStyle="{StaticResource TextBlock.Error}"
                                                            Header="{app:Lang {x:Static app:LangKey.PatternFileText}}" />

                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding RegisterFile, Converter={StaticResource FilePathToFileNameConverter}, TargetNullValue='--'}"
                                                            ElementStyle="{StaticResource TextBlock.Error}"
                                                            Header="{app:Lang {x:Static app:LangKey.RegisterFileText}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <wpf:SimplePanel Grid.Row="1"
                                             Grid.Column="2"
                                             Margin="0,10,0,0"
                                             HorizontalAlignment="Stretch">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding Data.CreateVectorCommand, Source={StaticResource MainDataContext}}"
                                        Content="{app:Lang {x:Static app:LangKey.CreateNewText}}" />
                                <Button HorizontalAlignment="Right"
                                        Command="{Binding Data.DeleteVectorCommand, Source={StaticResource MainDataContext}}"
                                        Content="{app:Lang {x:Static app:LangKey.DeleteText}}" />
                            </wpf:SimplePanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </wpf:StateBlock.CheckedContent>
        </wpf:StateBlock>
    </Grid>
</wpf:ChromeWindow>
