<wpf:ChromeWindow x:Class="LSIC.App.Views.PopVectorEditView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="PopVectorEditView"
                  Width="500"
                  d:DataContext="{d:DesignInstance vms:PopVectorEditViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.PatternFileText}}" />
                <Run Text=":" />
            </TextBlock>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center">
                <Run Text="{app:Lang {x:Static app:LangKey.RegisterFileText}}" />
                <Run Text=":" />
            </TextBlock>


            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="5,0"
                     VerticalAlignment="Center"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Text="{Binding Vector.PatternFile}" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="5"
                     VerticalAlignment="Center"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Text="{Binding Vector.RegisterFile}" />

            <Button Grid.Row="0"
                    Grid.Column="2"
                    Command="{Binding SelectPatternFileCommand}"
                    Style="{StaticResource Button.ChooseFile}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Command="{Binding SelectRegisterFileCommand}"
                    Style="{StaticResource Button.ChooseFile}" />
        </Grid>


        <Button Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource Button.Confirm}" />
        <Button Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Cancel}" />
    </Grid>


</wpf:ChromeWindow>
