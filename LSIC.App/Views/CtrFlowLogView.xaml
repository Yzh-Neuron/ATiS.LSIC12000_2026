<ListBox x:Class="LSIC.App.Views.CtrFlowLogView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:app="clr-namespace:LSIC.App"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:log="clr-namespace:ATiS.Sim.Log;assembly=ATiS.Sim.Log"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
         x:Name="LogView"
         Padding="10"
         d:DesignHeight="200"
         d:DesignWidth="400"
         Background="Transparent"
         BorderThickness="0"
         Cursor="Arrow"
         Foreground="{DynamicResource ForegroundBrush}"
         Grid.IsSharedSizeScope="True"
         ScrollViewer.CanContentScroll="True"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.ScrollChanged="OnScrollChanged"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         SelectionMode="Single"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.ScrollUnit="Item"
         VirtualizingPanel.VirtualizationMode="Recycling"
         mc:Ignorable="d">

    <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="PART_Border"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#26000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>

    <ListBox.ItemTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderGroup" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_Header"
                           VerticalAlignment="Top"
                           LineHeight="22"
                           Text="{Binding Header, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Top"
                           LineHeight="22"
                           Text="{Binding Message, Mode=OneWay}"
                           TextWrapping="WrapWithOverflow" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static log:LogLevel.Debug}">
                    <Setter TargetName="PART_Header" Property="Foreground" Value="{DynamicResource LogDebugBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static log:LogLevel.Info}">
                    <Setter TargetName="PART_Header" Property="Foreground" Value="{DynamicResource LogInfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static log:LogLevel.Warn}">
                    <Setter TargetName="PART_Header" Property="Foreground" Value="{DynamicResource LogWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static log:LogLevel.Error}">
                    <Setter TargetName="PART_Header" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static log:LogLevel.Fatal}">
                    <Setter TargetName="PART_Header" Property="Foreground" Value="{DynamicResource LogFatalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ListBox.ItemTemplate>

    <ListBox.ContextMenu>
        <ContextMenu wpf:MenuHelper.PopupMaxHeight="400">
            <MenuItem Click="OnClearLogs" Header="{app:Lang {x:Static app:LangKey.ClearLogsText}}" />
            <MenuItem Header="{app:Lang {x:Static app:LangKey.FrameFilterText}}" ItemsSource="{Binding PlacementTarget.FilterItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding FunctionCode, Converter={StaticResource EnumToTextConverter}}" />
                        <Setter Property="IsCheckable" Value="True" />
                        <Setter Property="StaysOpenOnClick" Value="True" />
                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="InputGestureText" Value="{Binding FunctionCode, Converter={StaticResource EnumToHexConverter}}" />
                        <Setter Property="MaxWidth" Value="200" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </ListBox.ContextMenu>
</ListBox>
