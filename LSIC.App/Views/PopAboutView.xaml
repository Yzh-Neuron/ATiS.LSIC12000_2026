<wpf:ChromeWindow x:Class="LSIC.App.Views.PopAboutView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.AboutText} }"
                  Width="400"
                  d:DataContext="{d:DesignInstance vms:PopAboutViewModel}"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  SizeToContent="Height"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Border Width="180">
                <Image RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{StaticResource ATiSImage}"
                       Stretch="Uniform" />
            </Border>
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="16">
                <Run Text="{Binding Title, Mode=OneWay}" />
                <Run Text="V" /><Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Text="{Binding Company}" />
            <TextBlock Margin="0,10,0,15"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Text="{Binding Copyright}" />
        </StackPanel>
    </Grid>
</wpf:ChromeWindow>
