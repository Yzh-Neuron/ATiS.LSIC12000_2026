<UserControl x:Class="LSIC.App.Views.CtrBurnInBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:LSIC.App.Models"
             xmlns:views="clr-namespace:LSIC.App.Views"
             xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
             mc:Ignorable="d"
             d:Width="435"
             d:Height="340"
             d:DataContext="{d:DesignInstance models:DutInfo}">

    <!-- 通用矩阵控件：只负责行列头、滚动联动、矩阵布局与多选；
         单元格的业务内容全部通过 ItemTemplate 提供 -->
    <wpf:MatrixListBox x:Name="PART_List"
                       ItemsSource="{Binding Duts}"
                       Rows="{Binding Rows}"
                       Cols="{Binding Cols}"
                       CellWidth="130"
                       CellHeight="42"
                       HeaderWidth="30"
                       HeaderHeight="30"
                       SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=views:CtrBurnInBoardView}, Path=SelectedDut}">
        <wpf:MatrixListBox.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 芯片图标 + Id + 选中光标 -->
                    <Grid Grid.Column="0">
                        <Path Margin="3"
                              Data="{StaticResource Geometry.Chip}"
                              Fill="{Binding State, Converter={StaticResource DutStateToBrushConverter}}"
                              Stretch="Fill" />
                        <!-- 选中四角光标：跟随所在 ListBoxItem 的 IsSelected -->
                        <Grid Margin="1"
                              Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Path Data="M 0 10 L 0 0 10 0 M 48 0 L 58 0 58 10 M 58 30 L 58 40 48 40 M 10 40 L 0 40 0 30"
                                  Stroke="Red"
                                  StrokeThickness="5" />
                        </Grid>
                        <TextBlock Text="{Binding Id}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- 温度（存在 ThermostatSettings 集合时：可编辑） -->
                    <Grid Grid.Column="1"
                          Visibility="{Binding RelativeSource={RelativeSource AncestorType=views:CtrBurnInBoardView}, Path=ThermostatSettings, Converter={StaticResource NullObjectToVisibilityConverter}}">
                        <Grid.DataContext>
                            <MultiBinding Converter="{StaticResource DutToThermostatSettingConverter}">
                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="DataContext.ThermostatId" />
                                <Binding RelativeSource="{RelativeSource AncestorType=views:CtrBurnInBoardView}" Path="ThermostatSettings" />
                            </MultiBinding>
                        </Grid.DataContext>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TargetTemperature, Converter={StaticResource ScaledIntToTemperatureConverter}}"
                                     BorderThickness="0,0,0,1"
                                     Background="Transparent"
                                     wpf:BorderHelper.CornerRadius="0"
                                     Visibility="{Binding Enable, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="0"
                                       Text="N/A"
                                       Visibility="{Binding Enable, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                       ToolTip="{DynamicResource ThermostatEnableClosedText}" />
                            <TextBlock Grid.Column="1"
                                       Text="℃"
                                       Margin="3,0,8,0" />
                        </Grid>
                    </Grid>

                    <!-- 温度（无 ThermostatSettings 集合时：只读显示 Dut.Thermostat） -->
                    <Grid Grid.Column="1"
                          Visibility="{Binding RelativeSource={RelativeSource AncestorType=views:CtrBurnInBoardView}, Path=ThermostatSettings, Converter={StaticResource InvertNullObjectToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="3,0,0,0"
                                       Text="{Binding Thermostat.Temperature, Converter={StaticResource ScaledIntToTemperatureConverter}, TargetNullValue='N/A'}"
                                       Visibility="{Binding Thermostat.Enable, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="0"
                                       Text="N/A"
                                       Visibility="{Binding Thermostat.Enable, Converter={StaticResource InvertBoolToVisibilityConverter}}"
                                       ToolTip="{DynamicResource ThermostatEnableClosedText}" />
                            <TextBlock Grid.Column="1"
                                       Text="℃"
                                       Margin="3,0,8,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>
        </wpf:MatrixListBox.ItemTemplate>
    </wpf:MatrixListBox>
</UserControl>
