<ScrollViewer x:Class="LSIC.App.Views.CtrDpsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:app="clr-namespace:LSIC.App"
              xmlns:bhs="clr-namespace:LSIC.App.Behaviors"
              xmlns:ctrs="clr-namespace:LSIC.App.Controls"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:models="clr-namespace:LSIC.App.Models"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
              xmlns:views="clr-namespace:LSIC.App.Views"
              xmlns:vms="clr-namespace:LSIC.App.ViewModels"
              xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              d:DataContext="{d:DesignInstance models:Zone}"
              d:Height="1080"
              d:Width="1920"
              Style="{StaticResource ScrollViewer.Default}"
              mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  VIH  -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Vihs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Vih}">
                    <Border Width="290"
                            Height="Auto"
                            Margin="0,0,10,0"
                            Background="{DynamicResource ThirdBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13"
                                           FontWeight="Bold"
                                           Text="{Binding Id, StringFormat={}VIH{0}}" />

                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <MultiBinding Converter="{StaticResource DpsStateToBrushConverter}">
                                                <Binding Mode="OneWay" Path="State" />
                                                <Binding Mode="OneWay"
                                                         Path="ThemeType"
                                                         Source="{x:Static models:Device.Instance}" />
                                            </MultiBinding>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock Width="95"
                                               Margin="5,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               wpf:LanguageHelper.Auto="True"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Text="{Binding State, Mode=OneWay, Converter={StaticResource EnumToTextConverter}}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource DpsStateToBrushConverter}">
                                                <Binding Mode="OneWay" Path="State" />
                                                <Binding Mode="OneWay"
                                                         Path="ThemeType"
                                                         Source="{x:Static models:Device.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Vertical">
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{DynamicResource FourthForegroundBrush}"
                                           Text="{app:Lang {x:Static app:LangKey.RealVoltageWithUnitText}}" />
                                <TextBlock Margin="0,10,10,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding OutputVoltage, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Vertical">
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{DynamicResource FourthForegroundBrush}"
                                           Text="{app:Lang {x:Static app:LangKey.SetVoltageWithUnitText}}" />
                                <TextBlock Margin="0,10,10,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource FourthForegroundBrush}"
                                           Text="{Binding SetVoltage, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  DPS  -->
        <ListBox Grid.Row="1"
                 Margin="0,10,0,0"
                 BorderThickness="0"
                 ItemsSource="{Binding Dpss}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Template>
                <ControlTemplate>
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThirdBackgroundBrush}" />
                    <Setter Property="MinHeight" Value="220" />
                    <Setter Property="Width" Value="200" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <wpf:SimplePanel Margin="0,0,10,10" d:DataContext="{d:DesignInstance models:Dps}">
                                    <Border x:Name="MainContainer"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DefaultCornerRadius}" />
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           Text="{Binding Id, Mode=OneWay, StringFormat={}DPS{0}}" />

                                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <MultiBinding Converter="{StaticResource DpsStateToBrushConverter}">
                                                                <Binding Mode="OneWay" Path="State" />
                                                                <Binding Mode="OneWay"
                                                                         Path="ThemeType"
                                                                         Source="{x:Static models:Device.Instance}" />
                                                            </MultiBinding>
                                                        </Ellipse.Fill>
                                                    </Ellipse>

                                                    <TextBlock Margin="5,0,0,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               wpf:LanguageHelper.Auto="True"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Text="{Binding State, Mode=OneWay, Converter={StaticResource EnumToTextConverter}}">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource DpsStateToBrushConverter}">
                                                                <Binding Mode="OneWay" Path="State" />
                                                                <Binding Mode="OneWay"
                                                                         Path="ThemeType"
                                                                         Source="{x:Static models:Device.Instance}" />
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>

                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FourthForegroundBrush}"
                                                       Text="{Binding ., Mode=OneWay, Converter={StaticResource DpsSpecConverter}}" />
                                        </Grid>

                                        <Rectangle Grid.Row="1"
                                                   Height="1"
                                                   Margin="0,5"
                                                   Stroke="{TemplateBinding BorderBrush}" />

                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="10" />
                                                <RowDefinition />
                                                <RowDefinition Height="10" />
                                                <RowDefinition />
                                                <RowDefinition Height="10" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  设定值  -->
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Foreground="{DynamicResource FourthForegroundBrush}"
                                                       Text="{app:Lang {x:Static app:LangKey.SetVoltageWithUnitText}}" />
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Text="{Binding Vol, Mode=OneWay, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}, TargetNullValue='--'}" />

                                            <!--  电压  -->
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Foreground="{DynamicResource FourthForegroundBrush}"
                                                       Text="{app:Lang {x:Static app:LangKey.RealVoltageWithUnitText}}" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       Text="{Binding OutputVoltage, Mode=OneWay, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}" />

                                            <!--  电流  -->
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="0"
                                                       Foreground="{DynamicResource FourthForegroundBrush}"
                                                       Text="{app:Lang {x:Static app:LangKey.RealCurrentWithUnitText}}" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Text="{Binding OutputCurrent, Mode=OneWay, Converter={StaticResource IntegerToDecimalConverter1000}, StringFormat={}{0:F3}}" />

                                            <!--  功率  -->
                                            <TextBlock Grid.Row="6"
                                                       Grid.Column="0"
                                                       Foreground="{DynamicResource FourthForegroundBrush}"
                                                       Text="{app:Lang {x:Static app:LangKey.RealPowerWithUnitText}}" />
                                            <TextBlock Grid.Row="6"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Text="{Binding OutputPower, Mode=OneWay, Converter={StaticResource IntegerToDecimalConverter1000000}, StringFormat={}{0:F3}}" />
                                        </Grid>

                                        <Rectangle Grid.Row="3"
                                                   Height="1"
                                                   Margin="0,5,0,10"
                                                   Stroke="{TemplateBinding BorderBrush}"
                                                   StrokeDashArray="3 6" />

                                        <Grid Grid.Row="4" Grid.ColumnSpan="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="5" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <ctrs:PowerBar Height="10"
                                                           BorderBrush="{DynamicResource SecondBorderBrush}"
                                                           BorderThickness="1"
                                                           MaxPower="{Binding MaxPower}"
                                                           Value="{Binding OutputPower}" />

                                            <TextBlock Grid.Row="2"
                                                       HorizontalAlignment="Left"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Text="0W" />
                                            <TextBlock Grid.Row="2"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       Text="{Binding MaxPower, StringFormat={}{0}W}" />
                                        </Grid>
                                    </Grid>
                                </wpf:SimplePanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="MainContainer" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="Effect" Value="{DynamicResource EffectShadow3}" />
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="true">
                                        <Setter TargetName="MainContainer" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</ScrollViewer>
