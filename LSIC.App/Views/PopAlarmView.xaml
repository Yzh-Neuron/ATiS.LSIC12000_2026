<wpf:ChromeWindow x:Class="LSIC.App.Views.PopAlarmView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:app="clr-namespace:LSIC.App"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="clr-namespace:LSIC.App.Models"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:views="clr-namespace:LSIC.App.Views"
                  xmlns:vms="clr-namespace:LSIC.App.ViewModels"
                  xmlns:wpf="clr-namespace:ATiS.Sim.Wpf;assembly=ATiS.Sim.Wpf"
                  Title="{app:Lang {x:Static app:LangKey.AlarmWindowText}}"
                  Width="500"
                  Height="380"
                  Icon="/Resources/Icon/icon.ico"
                  ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Background="{DynamicResource ErrorBrush}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="22"
                       Foreground="White"
                       Text="{app:Lang {x:Static app:LangKey.AlarmMessageText}}">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation AutoReverse="True"
                                                 RepeatBehavior="Forever"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.5"
                                                 To="1"
                                                 Duration="00:00:00.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Grid>
        <wpf:SimplePanel Grid.Row="1" Margin="10">
            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DefaultCornerRadius}" />
            <RichTextBox x:Name="LogBox"
                         Margin="5"
                         BorderThickness="0"
                         FontSize="15"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         VerticalScrollBarVisibility="Auto">
                <FlowDocument x:Name="LogFlowDocument" LineHeight="2.4" />
            </RichTextBox>
        </wpf:SimplePanel>
        <DockPanel Grid.Row="2"
                   Height="36"
                   Margin="0,0,0,10">
            <Button Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#FFD1D1"
                    Content="{app:Lang {x:Static app:LangKey.CloseAlarmText}}"
                    Foreground="{StaticResource ForegroundBrush}" />
            <Button Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#FFD1D1"
                    Content="{app:Lang {x:Static app:LangKey.CloseOvenAlarmText}}"
                    Foreground="{StaticResource ForegroundBrush}" />
            <Button Width="100"
                    Height="30"
                    Margin="10,0,10,0"
                    Background="DarkOrange"
                    Content="{app:Lang {x:Static app:LangKey.StopBurnText}}"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource ForegroundBrush}" />
            <Button Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="LightBlue"
                    Content="{app:Lang {x:Static app:LangKey.OneClickCoolText}}"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource ForegroundBrush}" />
            <Grid />
        </DockPanel>
    </Grid>
</wpf:ChromeWindow>
