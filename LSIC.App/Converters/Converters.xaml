<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:LSIC.App"
                    xmlns:cvt="clr-namespace:LSIC.App.Converters"
                    xmlns:models="clr-namespace:LSIC.App.Models">

    <cvt:EnumToTextPairsConverter x:Key="EnumToTextPairsConverter" />
    <cvt:EnumToTextConverter x:Key="EnumToTextConverter" />
    <cvt:EnumToHexConverter x:Key="EnumToHexConverter"/>

    <cvt:DecimalToDecimalConverter x:Key="DecimalToDecimalConverter"/>
    <cvt:IntegerToIntegerConverter x:Key="IntegerToIntegerConverter" />
    <cvt:IntegerToDecimalConverter x:Key="IntegerToDecimalConverter1000000" Scale="1000000" />
    <cvt:IntegerToDecimalConverter x:Key="IntegerToDecimalConverter1000" Scale="1000" />
    <cvt:IntegerToDecimalConverter x:Key="IntegerToDecimalConverter10" Scale="10" />

    <cvt:RangeToStringConverter x:Key="RangeToStringConverter" />
    <cvt:EnumerableToStringConverter x:Key="EnumerableToStringConverter" />
    <cvt:DivideConverter x:Key="DivideConverter" />
    <cvt:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
    <cvt:ZoneStateToBrushConverter x:Key="ZoneStateToBrushConverter" />
    <cvt:FormatTextConverter x:Key="FormatTextConverter" />
    <cvt:ProportionalWidthConverter x:Key="ProportionalWidthConverter" />
    <cvt:SecondsToTimeSpanStringConverter x:Key="SecondsToTimeSpanStringConverter" />
    <cvt:LinerChangeConverter x:Key="LinerChangeConverter" />
    <cvt:StepPowerHasDpsPlanToVisibilityConverter x:Key="StepPowerHasDpsPlanToVisibilityConverter" />
    <cvt:TimeSecondToTimeStringConverter x:Key="TimeSecondToTimeStringConverter" />
    <cvt:DutStateToBrushConverter x:Key="DutStateToBrushConverter"/>
    <cvt:DpsSpecConverter x:Key="DpsSpecConverter"/>
    <cvt:DpsStateToBrushConverter x:Key="DpsStateToBrushConverter"/>

    <cvt:ZoneStateToEnableConverter x:Key="ZoneStateToCanSendIc" Func="{x:Static app:ZoneStateExtension.CanSendIcFunc}" />
    <cvt:ZoneStateToEnableConverter x:Key="ZoneStateToCanStart" Func="{x:Static app:ZoneStateExtension.CanStartFunc}" />
    <cvt:ZoneStateToEnableConverter x:Key="ZoneStateToCanStop" Func="{x:Static app:ZoneStateExtension.CanStopFunc}" />
    <cvt:ZoneStateToEnableConverter x:Key="ZoneStateToRunning" Func="{x:Static app:ZoneStateExtension.RunningFunc}" />
    <cvt:ZoneStateToEnableConverter x:Key="ZoneStateToSending" Func="{x:Static app:ZoneStateExtension.SendingFunc}" />
</ResourceDictionary>